<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ENV-063: omfp.app's executable under the hardened runtime (Developer ID builds): the microphone for live voice in
     the window (WKWebView runs its JavaScript in WebKit's own processes, so no JIT entitlement here). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
