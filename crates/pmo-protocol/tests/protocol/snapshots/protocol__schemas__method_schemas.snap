            "string",
            "null"
          ]
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/WorkspaceKind"
        },
        "path": {
          "description": "Absolute path.",
          "type": "string"
        },
        "prNumber": {
          "format": "uint64",
          "minimum": 0,
