          ],
          "type": "object"
        },
        "WorkspaceKind": {
          "description": "How the daemon owns a workspace directory.",
          "oneOf": [
            {
              "const": "managed_worktree",
              "description": "A git worktree the daemon created and may remove (DMN-021).",
              "type": "string"
            },
            {
              "const": "adopted",
              "description": "An existing directory the daemon only records and never deletes (DMN-023).",
