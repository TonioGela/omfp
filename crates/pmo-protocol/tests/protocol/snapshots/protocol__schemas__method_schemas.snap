  "workspaces.remove": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.remove` params (DMN-024).",
      "properties": {
        "deleteBranch": {
          "default": false,
          "description": "Also delete the worktree's branch.",
          "type": "boolean"
        },
        "force": {
          "default": false,
          "description": "Remove even with uncommitted changes.",
          "type": "boolean"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId"
      ],
      "title": "RemoveWorkspaceParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "No params, or the `{}` result.",
      "title": "Empty",
      "type": "object"
    }
  },
  "workspaces.status": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Params naming one workspace.",
      "properties": {
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId"
      ],
      "title": "WorkspaceRef",
      "type": "object"
    },
    "result": {
      "$defs": {
        "FileChange": {
          "description": "One changed file with its line counts.",
          "properties": {
            "additions": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "deletions": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "oldPath": {
              "description": "Previous path of a renamed file.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/FileStatus"
            }
          },
          "required": [
            "path",
            "status",
            "additions",
            "deletions"
          ],
          "type": "object"
        },
        "FileStatus": {
          "description": "Kind of change to a file.",
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "untracked"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Git state of a workspace relative to its base ref (DMN-026).",
      "properties": {
        "ahead": {
          "description": "Commits on HEAD not in the base ref.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "baseRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "behind": {
          "description": "Commits in the base ref not on HEAD.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "branch": {
          "description": "`None` on a detached HEAD.",
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "description": "Files changed since the base ref, committed or not.",
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "type": "array"
        }
      },
      "required": [
        "ahead",
        "behind",
        "files"
      ],
      "title": "GitStatus",
      "type": "object"
    }
  }
}
