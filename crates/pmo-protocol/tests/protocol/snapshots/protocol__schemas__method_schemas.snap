        "topic": {
          "$ref": "#/$defs/Topic"
        }
      },
      "required": [
        "topic"
      ],
      "title": "TopicParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "No params, or the `{}` result.",
      "title": "Empty",
      "type": "object"
    }
  },
