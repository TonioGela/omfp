  "workspaces.diff": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.diff` params.",
      "properties": {
        "cursor": {
          "description": "`nextCursor` of the previous page.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Only this file.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId"
      ],
      "title": "WorkspaceDiffParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "FileDiff": {
          "description": "Unified diff of one file.",
          "properties": {
            "patch": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "truncated": {
              "description": "The patch was cut to fit the frame limit.",
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "patch",
            "truncated"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One page of a workspace diff (PRT-013).",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/FileDiff"
          },
          "type": "array"
        },
        "nextCursor": {
          "description": "Pass as `cursor` to fetch the next page; absent on the last page.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "files"
      ],
      "title": "DiffPage",
      "type": "object"
    }
  },
