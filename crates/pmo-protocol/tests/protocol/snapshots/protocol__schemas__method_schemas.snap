          "description": "Idle with nothing queued or pending (omp's `session_settled`).",
          "type": "boolean"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        },
        "workspaceIds": {
          "description": "Attached workspaces in order (ARC-008).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "tags",
        "workspaceIds",
        "process",
        "settled",
        "needsAttention",
        "provenance",
        "createdAt",
        "updatedAt"
      ],
      "title": "ThreadSummary",
      "type": "object"
    }
  },
  "threads.update": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
