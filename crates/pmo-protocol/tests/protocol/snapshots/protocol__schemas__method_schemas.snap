        "archivedAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "needsAttention": {
          "description": "Interactive requests are waiting for an answer.",
