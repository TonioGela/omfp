          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "SearchThreadsParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "ThreadSearchResult": {
          "description": "A thread whose conversation contains the query.",
          "properties": {
            "snippet": {
              "description": "A short excerpt around the first match.",
              "type": "string"
            },
            "threadId": {
              "type": "string"
            }
          },
          "required": [
            "threadId",
            "snippet"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`threads.search` result: most recently updated threads first, at most 200.",
      "properties": {
        "results": {
          "items": {
            "$ref": "#/$defs/ThreadSearchResult"
          },
          "type": "array"
        }
      },
      "required": [
