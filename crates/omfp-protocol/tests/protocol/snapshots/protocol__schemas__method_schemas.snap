  "threads.create": {
    "params": {
      "$defs": {
        "ApprovalMode": {
          "description": "omp's `--approval-mode` (`tools.approvalMode`): which tool calls omp asks the user to approve (DMN-074, DMN-210).\nomp 18.18.6 exits at startup on any other value.",
          "oneOf": [
            {
              "const": "always-ask",
              "description": "Runs read tools; asks before write and exec tools.",
              "type": "string"
            },
            {
              "const": "always-ask-cached",
              "description": "Like `always-ask`, but a file read or write can be approved for a file or folder, for the session or for\ngood.",
              "type": "string"
            },
            {
              "const": "write",
              "description": "Runs read and write tools; asks before exec tools.",
              "type": "string"
            },
            {
              "const": "yolo",
              "description": "Runs every tool without asking (the default).",
              "type": "string"
            }
          ]
        },
        "CreateWorkspaceParams": {
          "description": "`workspaces.create` params (DMN-020).",
          "properties": {
            "link": {
              "description": "A git repository to link into the new folder in the same call, as `workspaces.add_repo` with `link` does.",
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "description": "Unique name; default: the folder name of `link` when given, else `workspace` (made unique).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "ThreadWorkspace": {
          "description": "The workspace of a new thread.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "An existing workspace.",
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A new workspace, as `workspaces.create` makes it; its name defaults to the thread's title, else to the first\nwords of its first message.",
              "properties": {
                "new": {
                  "$ref": "#/$defs/CreateWorkspaceParams"
                }
              },
              "required": [
                "new"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`threads.create` params.",
      "properties": {
        "approvalMode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "omp's `--approval-mode`; default `yolo` (DMN-074, DMN-210)."
        },
        "model": {
          "description": "`provider/id`.",
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "description": "First message, sent once the thread is created; when omp cannot start for it, the thread is not created\n(DMN-211).",
          "type": [
            "string",
            "null"
          ]
        },
        "thinkingLevel": true,
        "title": {
          "description": "For scripts and agents; without it the title is generated from the conversation (DMN-073).",
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "$ref": "#/$defs/ThreadWorkspace",
          "default": {
            "new": {}
          },
          "description": "`{ \"id\": … }` or `{ \"new\": { \"name\"?, \"link\"? } }`; default: a new folder named after the first message."
        }
      },
      "title": "CreateThreadParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "CreatedBy": {
          "description": "The principal behind a created entity: the user, the agent of a thread, or an MCP client outside omfp (PRT-093),\nnamed by the provenance's `client`.",
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "user",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "thread",
                  "type": "string"
                },
                "threadId": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "threadId"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "mcp",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          ]
        },
        "Provenance": {
          "description": "Who created an entity (ARC-009).",
          "properties": {
            "client": {
              "description": "`client` of the creating connection's `system.hello` (PRT-033).",
              "type": [
                "string",
                "null"
              ]
            },
            "createdBy": {
              "$ref": "#/$defs/CreatedBy"
            }
          },
          "required": [
            "createdBy"
          ],
          "type": "object"
        },
        "TitleSource": {
          "description": "Where a thread's title comes from (DMN-073).",
          "oneOf": [
            {
              "const": "placeholder",
              "description": "The first words of the first message (or `\"\"` before it), until a title is generated or set.",
              "type": "string"
            },
            {
              "const": "generated",
              "description": "Generated from the conversation by the daemon.",
              "type": "string"
            },
            {
              "const": "set",
              "description": "Set by the user or an agent (`threads.create`, `threads.update`, host tool `set_thread_title`); never replaced.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What the thread list shows about a thread.",
      "properties": {
        "archivedAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "mcpReloadPending": {
          "description": "The thread's MCP configuration changed (or a server was reauthorized) while background work ran, so the daemon\ndid not restart its omp: `thread.mcp_reconnect` loads the new tools (PRT-121, DMN-204). Absent when `false`.",
          "type": "boolean"
        },
        "needsAttention": {
          "description": "Interactive requests are waiting for an answer.",
          "type": "boolean"
        },
        "process": {
          "description": "`omfp_core::ProcessState`."
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "settled": {
          "description": "Idle with nothing queued or pending (omp's `session_settled`).",
          "type": "boolean"
        },
        "title": {
          "description": "`\"\"` until the first message (DMN-073).",
          "type": "string"
        },
        "titleSource": {
          "$ref": "#/$defs/TitleSource"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        },
        "workspaceId": {
          "description": "The workspace the thread lives in: its omp cwd (ARC-008, DMN-029).",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "titleSource",
        "workspaceId",
        "process",
        "settled",
        "needsAttention",
        "provenance",
        "createdAt",
        "updatedAt"
      ],
      "title": "ThreadSummary",
      "type": "object"
    }
  },
  "threads.delete": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
