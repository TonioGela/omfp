          "properties": {
            "client": {
              "description": "`client` of the creating connection's `system.hello` (PRT-033).",
              "type": [
                "string",
                "null"
              ]
            },
            "createdBy": {
              "$ref": "#/$defs/CreatedBy"
            }
          },
          "required": [
            "createdBy"
          ],
          "type": "object"
        },
        "WorkspaceRepo": {
          "description": "A repository discovered in a workspace folder (DMN-022).",
          "oneOf": [
            {
              "description": "A symlink to a repository elsewhere.",
              "properties": {
                "kind": {
                  "const": "link",
                  "type": "string"
                },
                "target": {
                  "description": "The symlink's target, as written in the link.",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "target"
              ],
              "type": "object"
            },
            {
              "description": "A linked git worktree.",
              "properties": {
                "kind": {
                  "const": "worktree",
                  "type": "string"
                },
                "main": {
                  "description": "Root of the main working tree (`git rev-parse --git-common-dir`).",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "main"
              ],
              "type": "object"
            },
            {
              "description": "A repository of its own (a clone, or a folder initialized in place).",
              "properties": {
                "kind": {
                  "const": "clone",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          ],
          "properties": {
            "branch": {
              "description": "`None` on a detached HEAD.",
              "type": [
                "string",
                "null"
              ]
            },
            "canonicalPath": {
              "description": "The checkout with symlinks resolved: entries with the same canonical path are the same files (DMN-027).",
              "type": "string"
            },
            "head": {
              "description": "Commit id of HEAD; `None` before the first commit.",
              "type": [
                "string",
                "null"
              ]
            },
            "isRoot": {
              "description": "The workspace folder itself is this repository.",
              "type": "boolean"
            },
            "name": {
              "description": "Entry name in the folder; the folder's own name for the root.",
              "type": "string"
            },
            "path": {
              "description": "Path inside the workspace (the symlink path for a link, never its target).",
              "type": "string"
            },
            "sharedWith": {
              "description": "Other workspaces holding the same checkout (same canonical path), so clients can warn (DMN-027).",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "name",
            "path",
            "isRoot",
            "canonicalPath",
            "sharedWith"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A folder threads work in; its repositories are its top-level entries (D-11, DMN-020).",
      "properties": {
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "description": "Unique among workspaces.",
          "type": "string"
        },
        "path": {
          "description": "Absolute path of the folder (under the daemon's workspaces root), unique among workspaces.",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "repos": {
          "description": "Repositories discovered in the folder (DMN-022): the folder itself first when it is a git root, then the\nentries by name.",
          "items": {
            "$ref": "#/$defs/WorkspaceRepo"
          },
          "type": "array"
        },
        "threadIds": {
          "description": "Threads living in the workspace, archived ones included, oldest first (DMN-027).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "repos",
        "threadIds",
        "provenance",
        "createdAt"
      ],
      "title": "Workspace",
      "type": "object"
    }
  },
  "workspaces.write_file": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.write_file` params (DMN-090).",
      "properties": {
        "content": {
          "description": "The new text of the file (UTF-8).",
          "type": "string"
        },
        "expectedHash": {
          "description": "The `hash` of the file the text was based on: a file that no longer has it is `conflict`. Absent: the file\nmust not exist yet.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "As in `workspaces.read_file`, without the fallback to the repositories.",
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "path",
        "content"
      ],
      "title": "WriteFileParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The result of `workspaces.write_file` (DMN-090).",
      "properties": {
        "hash": {
          "description": "Hex SHA-1 of the written bytes.",
          "type": "string"
        },
        "path": {
          "description": "Relative to the workspace folder.",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "hash",
        "size"
      ],
      "title": "FileWritten",
      "type": "object"
    }
  }
}
