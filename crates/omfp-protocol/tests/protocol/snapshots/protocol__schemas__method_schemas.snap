  "thread.prompt": {
    "params": {
      "$defs": {
        "PromptBehavior": {
          "description": "How a prompt sent while the agent is busy is queued.",
          "enum": [
            "steer",
            "followUp"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`thread.prompt` params.",
      "properties": {
        "behavior": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptBehavior"
            },
            {
              "type": "null"
            }
          ]
        },
        "images": {
          "items": true,
          "type": "array"
        },
        "text": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "text"
      ],
      "title": "PromptParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`thread.prompt` result, sent once omp admits the prompt (PRT-030).",
      "properties": {
        "agentInvoked": {
          "description": "`false` when omp handled the prompt locally: no `prompt_result` follows.",
          "type": "boolean"
        },
        "promptId": {
          "description": "The `id` of the `prompt_result` that ends this prompt.",
          "type": "string"
        }
      },
      "required": [
        "promptId",
        "agentInvoked"
      ],
      "title": "PromptResult",
      "type": "object"
    }
  },
