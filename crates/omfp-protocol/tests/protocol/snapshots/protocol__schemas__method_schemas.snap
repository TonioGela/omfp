  "workspaces.add_repo": {
    "params": {
      "$defs": {
        "RepoSource": {
          "description": "Where a repository added to a workspace comes from (DMN-024).",
          "oneOf": [
            {
              "description": "A symlink `<name> → <path>`.",
              "properties": {
                "kind": {
                  "const": "link",
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "path"
              ],
              "type": "object"
            },
            {
              "description": "`git worktree add` of a repository.",
              "properties": {
                "baseRef": {
                  "description": "Base of a new branch; default: the repository's checked-out branch.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "branch": {
                  "description": "Existing branch to check out, or new branch name; default: a new `omfp/<slug>-<n>` branch.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "const": "worktree",
                  "type": "string"
                },
                "repo": {
                  "description": "A path inside a git repository (e.g. a `repos.suggest` path).",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "repo"
              ],
              "type": "object"
            },
            {
              "description": "`git clone <url> <name>`.",
              "properties": {
                "kind": {
                  "const": "clone",
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "url"
              ],
              "type": "object"
            },
            {
              "description": "A pull request's head as a worktree (after S-08).",
              "properties": {
                "kind": {
                  "const": "pr",
                  "type": "string"
                },
                "pr": {
                  "description": "PR URL or `owner/repo#N`.",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "pr"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.add_repo` params (DMN-024).",
      "properties": {
        "name": {
          "description": "Entry name in the folder; default: derived from the source (made unique).",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/RepoSource"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "source"
      ],
      "title": "AddRepoParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "CreatedBy": {
          "description": "The principal behind a created entity: the user, the agent of a thread, or an MCP client outside omfp (PRT-093),\nnamed by the provenance's `client`.",
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "user",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "thread",
                  "type": "string"
                },
                "threadId": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "threadId"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "mcp",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          ]
        },
        "Provenance": {
          "description": "Who created an entity (ARC-009).",
          "properties": {
            "client": {
              "description": "`client` of the creating connection's `system.hello` (PRT-033).",
              "type": [
                "string",
                "null"
              ]
            },
            "createdBy": {
              "$ref": "#/$defs/CreatedBy"
            }
          },
          "required": [
            "createdBy"
          ],
          "type": "object"
        },
        "WorkspaceRepo": {
          "description": "A repository discovered in a workspace folder (DMN-022).",
          "oneOf": [
            {
              "description": "A symlink to a repository elsewhere.",
              "properties": {
                "kind": {
                  "const": "link",
                  "type": "string"
                },
                "target": {
                  "description": "The symlink's target, as written in the link.",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "target"
              ],
              "type": "object"
            },
            {
              "description": "A linked git worktree.",
              "properties": {
                "kind": {
                  "const": "worktree",
                  "type": "string"
                },
                "main": {
                  "description": "Root of the main working tree (`git rev-parse --git-common-dir`).",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "main"
              ],
              "type": "object"
            },
            {
              "description": "A repository of its own (a clone, or a folder initialized in place).",
              "properties": {
                "kind": {
                  "const": "clone",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          ],
          "properties": {
            "branch": {
              "description": "`None` on a detached HEAD.",
              "type": [
                "string",
                "null"
              ]
            },
            "canonicalPath": {
              "description": "The checkout with symlinks resolved: entries with the same canonical path are the same files (DMN-027).",
              "type": "string"
            },
            "head": {
              "description": "Commit id of HEAD; `None` before the first commit.",
              "type": [
                "string",
                "null"
              ]
            },
            "isRoot": {
              "description": "The workspace folder itself is this repository.",
              "type": "boolean"
            },
            "name": {
              "description": "Entry name in the folder; the folder's own name for the root.",
              "type": "string"
            },
            "path": {
              "description": "Path inside the workspace (the symlink path for a link, never its target).",
              "type": "string"
            },
            "sharedWith": {
              "description": "Other workspaces holding the same checkout (same canonical path), so clients can warn (DMN-027).",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "name",
            "path",
            "isRoot",
            "canonicalPath",
            "sharedWith"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A folder threads work in; its repositories are its top-level entries (D-11, DMN-020).",
      "properties": {
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "description": "Unique among workspaces.",
          "type": "string"
        },
        "path": {
          "description": "Absolute path of the folder (under the daemon's workspaces root), unique among workspaces.",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "repos": {
          "description": "Repositories discovered in the folder (DMN-022): the folder itself first when it is a git root, then the\nentries by name.",
          "items": {
            "$ref": "#/$defs/WorkspaceRepo"
          },
          "type": "array"
        },
        "threadIds": {
          "description": "Threads living in the workspace, archived ones included, oldest first (DMN-027).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "repos",
        "threadIds",
        "provenance",
        "createdAt"
      ],
      "title": "Workspace",
      "type": "object"
    }
  },
