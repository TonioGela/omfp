  "workspaces.status": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.status` params.",
      "properties": {
        "repo": {
          "description": "The repository's name in the workspace.",
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "repo"
      ],
      "title": "RepoRef",
      "type": "object"
    },
    "result": {
      "$defs": {
        "FileChange": {
          "description": "One changed file with its line counts.",
          "properties": {
            "additions": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "deletions": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "oldPath": {
              "description": "Previous path of a renamed file.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/FileStatus"
            }
          },
          "required": [
            "path",
            "status",
            "additions",
            "deletions"
          ],
          "type": "object"
        },
        "FileStatus": {
          "description": "Kind of change to a file.",
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "untracked"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Git state of a repository relative to its upstream or base ref (DMN-026).",
      "properties": {
        "ahead": {
          "description": "Commits on HEAD not in the base ref.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "baseRef": {
          "description": "What `ahead`/`behind` count against: the branch's upstream; absent without one.",
          "type": [
            "string",
            "null"
          ]
        },
        "behind": {
          "description": "Commits in the base ref not on HEAD.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "branch": {
          "description": "`None` on a detached HEAD.",
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "description": "Uncommitted changes, untracked files included.",
          "type": "boolean"
        },
        "files": {
          "description": "Files changed since the base ref, committed or not.",
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "type": "array"
        }
      },
      "required": [
        "ahead",
        "behind",
        "dirty",
        "files"
      ],
      "title": "GitStatus",
      "type": "object"
    }
  },
