                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "UI settings and key bindings the daemon keeps in its config file (DMN-009, UI-097).",
      "properties": {
        "error": {
          "description": "Why the last reload of the config file failed (the previous settings stay); `null` when it is valid.",
          "type": [
            "string",
            "null"
          ]
        },
        "keymap": {
          "description": "Bindings over the defaults, in file order; `command: \"\"` removes a default binding.",
          "items": {
            "$ref": "#/$defs/KeymapEntry"
          },
          "type": "array"
        },
        "ui": {
          "$ref": "#/$defs/UiSettings"
        }
      },
      "required": [
        "ui",
        "keymap",
        "error"
      ],
      "title": "Settings",
      "type": "object"
    }
  },
  "subscribe": {
    "params": {
      "$defs": {
        "Position": {
          "description": "A position in a topic's event stream.",
          "properties": {
            "epoch": {
              "type": "string"
            },
            "seq": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "epoch",
            "seq"
          ],
          "type": "object"
        },
        "Topic": {
          "description": "`index`, `thread/<id>`, `workspace/<id>`, `terminal/<id>`, `views/<id>` or `job/<id>`.",
          "pattern": "^(index|(thread|workspace|terminal|views|job)/[A-Za-z0-9_-]+)$",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`subscribe` params (PRT-020).",
      "properties": {
        "since": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last event the client has; the daemon replays from there when it still can."
        },
        "topic": {
          "$ref": "#/$defs/Topic"
        }
      },
      "required": [
        "topic"
      ],
      "title": "SubscribeParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`subscribe` result: catch-up from the ring buffer, or a full state (PRT-020, PRT-021).",
      "oneOf": [
        {
          "description": "Events from `fromSeq` follow as `event` frames.",
          "properties": {
            "epoch": {
              "type": "string"
            },
            "fromSeq": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "mode": {
              "const": "replay",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "epoch",
            "fromSeq"
          ],
          "type": "object"
        },
        {
          "description": "The topic's state at `seq`; live events after `seq` follow. `state` is a `omfp_core::ThreadState` for\n`thread/<id>`, an `IndexSnapshot` for `index`, and a list of `RepoStatus` for `workspace/<id>`.",
          "properties": {
            "epoch": {
              "type": "string"
            },
            "mode": {
              "const": "snapshot",
              "type": "string"
            },
            "seq": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "state": true
          },
          "required": [
            "mode",
            "epoch",
            "seq",
            "state"
          ],
          "type": "object"
        }
      ],
      "title": "SubscribeResult"
    }
  },
  "system.hello": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`system.hello`: first frame of every connection (PRT-001).",
      "properties": {
        "client": {
          "description": "Client name, recorded as provenance (PRT-033), e.g. `omfp/web`.",
          "type": "string"
        },
        "protocol": {
          "description": "Protocol version the client speaks (PRT-004).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "token": {
          "description": "The daemon's access token (PRT-002).",
          "type": "string"
        }
      },
      "required": [
        "token",
        "protocol",
        "client"
      ],
      "title": "HelloParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`system.hello` result (PRT-005).",
      "properties": {
        "connection": {
          "description": "Number of this connection, unique while the daemon runs: the `owner.connection` of the live sessions it\nstarts (PRT-051).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "daemon": {
          "description": "Daemon version.",
          "type": "string"
        },
        "omp": {
          "description": "omp version.",
          "type": "string"
        },
        "protocol": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "widgetBase": {
          "description": "Path under which this daemon serves widget modules to this client (`/widgets/<key>`, DMN-084, PRT-042).",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "daemon",
        "omp",
        "warnings",
        "widgetBase",
        "connection"
      ],
      "title": "HelloResult",
      "type": "object"
    }
  },
