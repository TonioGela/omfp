  "threads.create": {
    "params": {
      "$defs": {
        "CreateWorkspaceParams": {
          "description": "`workspaces.create` params (DMN-020).",
          "properties": {
            "name": {
              "description": "Unique name; default: the folder's name for an existing folder, else `workspace` (made unique).",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "An existing folder to record (not owned by the daemon); absent: a new folder under the workspaces root.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "ThreadWorkspace": {
          "description": "The workspace of a new thread.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "An existing workspace.",
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A new workspace, as `workspaces.create` makes it; its name defaults to the thread's title.",
              "properties": {
                "new": {
                  "$ref": "#/$defs/CreateWorkspaceParams"
                }
              },
              "required": [
                "new"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`threads.create` params.",
      "properties": {
        "approvalMode": {
          "description": "omp's `--approval-mode`.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "description": "`provider/id`.",
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "description": "First message, sent once the thread is created.",
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "thinkingLevel": true,
        "title": {
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/ThreadWorkspace",
          "default": {
            "new": {}
          },
          "description": "`{ \"id\": … }` or `{ \"new\": { \"name\"?, \"path\"? } }`; default: a new folder named after the title."
        }
      },
      "required": [
        "title"
      ],
      "title": "CreateThreadParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "CreatedBy": {
          "description": "The principal behind a created entity: the user, or the agent of a thread.",
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "user",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "thread",
                  "type": "string"
                },
                "threadId": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "threadId"
              ],
              "type": "object"
            }
          ]
        },
        "Provenance": {
          "description": "Who created an entity (ARC-009).",
          "properties": {
            "client": {
              "description": "`client` of the creating connection's `system.hello` (PRT-033).",
              "type": [
                "string",
                "null"
              ]
            },
            "createdBy": {
              "$ref": "#/$defs/CreatedBy"
            }
          },
          "required": [
            "createdBy"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "What the thread list shows about a thread.",
      "properties": {
        "archivedAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "needsAttention": {
          "description": "Interactive requests are waiting for an answer.",
          "type": "boolean"
        },
        "process": {
          "description": "`omfp_core::ProcessState`."
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "settled": {
          "description": "Idle with nothing queued or pending (omp's `session_settled`).",
          "type": "boolean"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        },
        "workspaceId": {
          "description": "The workspace the thread lives in: its omp cwd (ARC-008, DMN-029).",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "tags",
        "workspaceId",
        "process",
        "settled",
        "needsAttention",
        "provenance",
        "createdAt",
        "updatedAt"
      ],
      "title": "ThreadSummary",
      "type": "object"
    }
  },
