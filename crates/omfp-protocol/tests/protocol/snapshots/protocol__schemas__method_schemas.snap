              "description": "`enabled: false`, or named in the user config's `disabledServers`: omp does not load it.",
              "type": "string"
            }
          ]
        },
        "McpTransport": {
          "description": "How omp talks to a server.",
          "enum": [
            "stdio",
            "http",
            "sse"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.mcp_servers`, `thread.mcp_servers` and `thread.mcp_reconnect` result (PRT-110..PRT-112).",
      "properties": {
        "projectConfig": {
          "description": "omp's project config of the workspace, `<workspace>/.omp/mcp.json`, whether it exists or not.",
