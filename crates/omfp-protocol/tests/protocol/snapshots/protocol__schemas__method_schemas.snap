              ],
              "type": "object"
            }
          ]
        },
        "Provenance": {
          "description": "Who created an entity (ARC-009).",
          "properties": {
            "client": {
              "description": "`client` of the creating connection's `system.hello` (PRT-033).",
              "type": [
                "string",
                "null"
              ]
            },
            "createdBy": {
              "$ref": "#/$defs/CreatedBy"
            }
          },
          "required": [
            "createdBy"
          ],
          "type": "object"
        },
        "WorkspaceRepo": {
          "description": "A repository discovered in a workspace folder (DMN-022).",
          "oneOf": [
            {
              "description": "A symlink to a repository elsewhere.",
              "properties": {
                "kind": {
                  "const": "link",
                  "type": "string"
                },
                "target": {
                  "description": "The symlink's target, as written in the link.",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "target"
              ],
              "type": "object"
            },
            {
              "description": "A linked git worktree.",
              "properties": {
                "kind": {
                  "const": "worktree",
                  "type": "string"
                },
                "main": {
                  "description": "Root of the main working tree (`git rev-parse --git-common-dir`).",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "main"
              ],
              "type": "object"
            },
            {
              "description": "A repository of its own (a clone, or a folder initialized in place).",
              "properties": {
                "kind": {
                  "const": "clone",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          ],
          "properties": {
            "branch": {
              "description": "`None` on a detached HEAD.",
              "type": [
                "string",
                "null"
              ]
            },
            "canonicalPath": {
              "description": "The checkout with symlinks resolved: entries with the same canonical path are the same files (DMN-027).",
              "type": "string"
            },
            "head": {
              "description": "Commit id of HEAD; `None` before the first commit.",
              "type": [
                "string",
                "null"
              ]
            },
            "isRoot": {
              "description": "The workspace folder itself is this repository.",
              "type": "boolean"
            },
            "name": {
              "description": "Entry name in the folder; the folder's own name for the root.",
              "type": "string"
            },
            "path": {
              "description": "Path inside the workspace (the symlink path for a link, never its target).",
              "type": "string"
            },
            "sharedWith": {
              "description": "Other workspaces holding the same checkout (same canonical path), so clients can warn (DMN-027).",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "name",
            "path",
            "isRoot",
            "canonicalPath",
            "sharedWith"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A folder threads work in; its repositories are its top-level entries (D-11, DMN-020).",
      "properties": {
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "description": "Unique among workspaces.",
          "type": "string"
        },
        "owned": {
          "description": "The daemon created the folder and may delete it (DMN-028).",
          "type": "boolean"
        },
        "path": {
          "description": "Absolute path of the folder, unique among workspaces.",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "repos": {
          "description": "Repositories discovered in the folder (DMN-022): the folder itself first when it is a git root, then the\nentries by name.",
          "items": {
            "$ref": "#/$defs/WorkspaceRepo"
          },
          "type": "array"
        },
        "threadIds": {
          "description": "Threads living in the workspace, archived ones included, oldest first (DMN-027).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "owned",
        "repos",
        "threadIds",
        "provenance",
        "createdAt"
      ],
      "title": "Workspace",
      "type": "object"
    }
  },
  "workspaces.status": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.status` params.",
      "properties": {
        "repo": {
          "description": "The repository's name in the workspace.",
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "repo"
      ],
      "title": "RepoRef",
      "type": "object"
    },
    "result": {
      "$defs": {
        "FileChange": {
          "description": "One changed file with its line counts.",
          "properties": {
            "additions": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "deletions": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "oldPath": {
              "description": "Previous path of a renamed file.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/FileStatus"
            }
          },
          "required": [
            "path",
            "status",
            "additions",
            "deletions"
          ],
          "type": "object"
        },
        "FileStatus": {
          "description": "Kind of change to a file.",
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "untracked"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Git state of a repository relative to its upstream or base ref (DMN-026).",
      "properties": {
        "ahead": {
          "description": "Commits on HEAD not in the base ref.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "baseRef": {
          "description": "What `ahead`/`behind` count against: the branch's upstream; absent without one.",
          "type": [
            "string",
            "null"
          ]
        },
        "behind": {
          "description": "Commits in the base ref not on HEAD.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "branch": {
          "description": "`None` on a detached HEAD.",
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "description": "Uncommitted changes, untracked files included.",
          "type": "boolean"
        },
        "files": {
          "description": "Files changed since the base ref, committed or not.",
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "type": "array"
        }
      },
      "required": [
        "ahead",
        "behind",
        "dirty",
        "files"
      ],
      "title": "GitStatus",
      "type": "object"
    }
  },
