          ]
        }
      },
      "title": "ListTerminalsParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "TerminalInfo": {
          "description": "An open terminal.",
          "properties": {
            "cols": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/TerminalKind"
            },
            "rows": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "threadId": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspaceId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
