        },
        "Motion": {
          "description": "How much the UI animates (UI-145); `prefers-reduced-motion: reduce` caps it at `none`.",
          "oneOf": [
            {
              "const": "full",
              "description": "Every effect of the motion catalogue (default).",
              "type": "string"
            },
            {
              "const": "reduced",
              "description": "State indicators and short UI feedback only, with a steady caret.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "No animation or transition.",
              "type": "string"
            }
          ]
        },
        "NotificationMode": {
          "description": "When the UI shows system notifications (UI-096).",
          "oneOf": [
            {
              "enum": [
                "always",
                "never"
              ],
              "type": "string"
            },
            {
              "const": "background",
              "description": "Only while the window has no focus (default).",
              "type": "string"
            }
          ]
        },
        "UiSettings": {
          "description": "The `[ui]` table of the config file; an absent value is the default (UI-097).",
          "properties": {
            "density": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Density"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fontSize": {
              "description": "Root font size in px (10..=28, default 17); every rem-based size token scales with it.",
              "format": "uint8",
              "maximum": 28,
              "minimum": 10,
              "type": [
