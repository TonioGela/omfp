---
source: crates/omfp-protocol/tests/protocol/schemas.rs
expression: method_schemas()
---
{
  "interaction.respond": {
    "params": {
      "$defs": {
        "InteractionResponse": {
          "description": "Answer to an interactive request: exactly one of `value`, `confirmed`, `cancelled` (always true) or `answers`.",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "confirmed": {
                  "type": "boolean"
                }
              },
              "required": [
                "confirmed"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "cancelled": {
                  "const": true
                }
              },
              "required": [
                "cancelled"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "answers": {
                  "items": true,
                  "type": "array"
                }
              },
              "required": [
                "answers"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`interaction.respond` params (DMN-051).",
      "properties": {
        "interactionId": {
          "type": "string"
        },
        "response": {
          "$ref": "#/$defs/InteractionResponse"
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "interactionId",
        "response"
      ],
      "title": "RespondParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "No params, or the `{}` result.",
      "title": "Empty",
      "type": "object"
    }
  },
  "repos.add": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`repos.add` params.",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "AddRepositoryParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A known git repository: a shortcut for adding repositories to workspaces (DMN-021).",
      "properties": {
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "defaultBaseRef": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "description": "Absolute path of the repository root.",
          "type": "string"
        },
        "remoteUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "defaultBaseRef",
        "createdAt"
      ],
      "title": "Repository",
      "type": "object"
    }
  },
  "repos.list": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "No params, or the `{}` result.",
      "title": "Empty",
      "type": "object"
    },
    "result": {
      "$defs": {
        "Repository": {
          "description": "A known git repository: a shortcut for adding repositories to workspaces (DMN-021).",
          "properties": {
            "createdAt": {
              "format": "int64",
              "type": "integer"
            },
            "defaultBaseRef": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "path": {
              "description": "Absolute path of the repository root.",
              "type": "string"
            },
            "remoteUrl": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "path",
            "defaultBaseRef",
            "createdAt"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`repos.list` result.",
      "properties": {
        "repositories": {
          "items": {
            "$ref": "#/$defs/Repository"
          },
          "type": "array"
        }
      },
      "required": [
        "repositories"
      ],
      "title": "RepositoryList",
      "type": "object"
    }
  },
  "repos.remove": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Params naming one repository.",
      "properties": {
        "repositoryId": {
          "type": "string"
        }
      },
      "required": [
        "repositoryId"
      ],
      "title": "RepositoryRef",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "No params, or the `{}` result.",
      "title": "Empty",
      "type": "object"
    }
  },
  "subscribe": {
    "params": {
      "$defs": {
        "Position": {
          "description": "A position in a topic's event stream.",
          "properties": {
            "epoch": {
              "type": "string"
            },
            "seq": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "epoch",
            "seq"
          ],
          "type": "object"
        },
        "Topic": {
          "description": "`index`, `thread/<id>`, `workspace/<id>` or `terminal/<id>`.",
          "pattern": "^(index|(thread|workspace|terminal)/[A-Za-z0-9_-]+)$",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`subscribe` params (PRT-020).",
      "properties": {
        "since": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last event the client has; the daemon replays from there when it still can."
        },
        "topic": {
          "$ref": "#/$defs/Topic"
        }
      },
      "required": [
        "topic"
      ],
      "title": "SubscribeParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`subscribe` result: catch-up from the ring buffer, or a full state (PRT-020, PRT-021).",
      "oneOf": [
        {
          "description": "Events from `fromSeq` follow as `event` frames.",
          "properties": {
            "epoch": {
              "type": "string"
            },
            "fromSeq": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "mode": {
              "const": "replay",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "epoch",
            "fromSeq"
          ],
          "type": "object"
        },
        {
          "description": "The topic's state at `seq`; live events after `seq` follow. `state` is a `omfp_core::ThreadState` for\n`thread/<id>`, an `IndexSnapshot` for `index`, and a list of `RepoStatus` for `workspace/<id>`.",
          "properties": {
            "epoch": {
              "type": "string"
            },
            "mode": {
              "const": "snapshot",
              "type": "string"
            },
            "seq": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "state": true
          },
          "required": [
            "mode",
            "epoch",
            "seq",
            "state"
          ],
          "type": "object"
        }
      ],
      "title": "SubscribeResult"
    }
  },
  "system.hello": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`system.hello`: first frame of every connection (PRT-001).",
      "properties": {
        "client": {
          "description": "Client name, recorded as provenance (PRT-033), e.g. `omfp-ui/web`.",
          "type": "string"
        },
        "protocol": {
          "description": "Protocol version the client speaks (PRT-004).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "token": {
          "description": "The daemon's access token (PRT-002).",
          "type": "string"
        }
      },
      "required": [
        "token",
        "protocol",
        "client"
      ],
      "title": "HelloParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`system.hello` result (PRT-005).",
      "properties": {
        "daemon": {
          "description": "Daemon version.",
          "type": "string"
        },
        "omp": {
          "description": "omp version.",
          "type": "string"
        },
        "protocol": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "protocol",
        "daemon",
        "omp",
        "warnings"
      ],
      "title": "HelloResult",
      "type": "object"
    }
  },
  "terminal.close": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Params naming one terminal.",
      "properties": {
        "terminalId": {
          "type": "string"
        }
      },
      "required": [
        "terminalId"
      ],
      "title": "TerminalRef",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "No params, or the `{}` result.",
      "title": "Empty",
      "type": "object"
    }
  },
  "terminal.list": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`terminal.list` params; filters combine.",
      "properties": {
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "ListTerminalsParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "TerminalInfo": {
          "description": "An open terminal.",
          "properties": {
            "cols": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/TerminalKind"
            },
            "rows": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "threadId": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspaceId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "cols",
            "rows"
          ],
          "type": "object"
        },
        "TerminalKind": {
          "description": "What runs in a terminal (05-terminal).",
          "oneOf": [
            {
              "const": "omp",
              "description": "Interactive omp on the thread's session.",
              "type": "string"
            },
            {
              "const": "shell",
              "description": "A login shell.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`terminal.list` result.",
      "properties": {
        "terminals": {
          "items": {
            "$ref": "#/$defs/TerminalInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "terminals"
      ],
      "title": "TerminalList",
      "type": "object"
    }
  },
  "terminal.open": {
    "params": {
      "$defs": {
        "TerminalKind": {
          "description": "What runs in a terminal (05-terminal).",
          "oneOf": [
            {
              "const": "omp",
              "description": "Interactive omp on the thread's session.",
              "type": "string"
            },
            {
              "const": "shell",
              "description": "A login shell.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`terminal.open` params (05-terminal).",
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/TerminalKind"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "threadId": {
          "description": "Required for `omp`; for `shell`, the thread whose home is the cwd.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "description": "For `shell`: the workspace used as cwd.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "cols",
        "rows"
      ],
      "title": "OpenTerminalParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`terminal.open` result.",
      "properties": {
        "channel": {
          "description": "Binary-frame channel of this terminal on this connection.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "terminalId": {
          "type": "string"
        }
      },
      "required": [
        "terminalId",
        "channel"
      ],
      "title": "OpenTerminalResult",
      "type": "object"
    }
  },
  "terminal.resize": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`terminal.resize` params.",
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "terminalId": {
          "type": "string"
        }
      },
      "required": [
        "terminalId",
        "cols",
        "rows"
      ],
      "title": "ResizeTerminalParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "No params, or the `{}` result.",
      "title": "Empty",
      "type": "object"
    }
  },
  "thread.abort": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Params naming one thread.",
      "properties": {
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId"
      ],
      "title": "ThreadRef",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AnyValue"
    }
  },
  "thread.bash": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`thread.bash` params.",
      "properties": {
        "command": {
          "type": "string"
        },
        "excludeFromContext": {
          "description": "Keep the command and its output out of the model's context.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "command"
      ],
      "title": "BashParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AnyValue"
    }
  },
  "thread.btw": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`thread.btw` params.",
      "properties": {
        "question": {
          "type": "string"
        },
        "recordId": {
          "description": "Continue this side-question topic.",
          "type": [
            "string",
            "null"
          ]
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "question"
      ],
      "title": "BtwParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AnyValue"
    }
  },
  "thread.commands": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Params naming one thread.",
      "properties": {
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId"
      ],
      "title": "ThreadRef",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AnyValue"
    }
  },
  "thread.compact": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`thread.compact` params.",
      "properties": {
        "instructions": {
          "type": [
            "string",
            "null"
          ]
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId"
      ],
      "title": "CompactParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AnyValue"
    }
  },
  "thread.follow_up": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`thread.steer` / `thread.follow_up` params.",
      "properties": {
        "images": {
          "items": true,
          "type": "array"
        },
        "text": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "text"
      ],
      "title": "MessageParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "No params, or the `{}` result.",
      "title": "Empty",
      "type": "object"
    }
  },
  "thread.fork": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`thread.fork` params.",
      "properties": {
        "entryId": {
          "description": "Fork history through this entry; the whole session when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId"
      ],
      "title": "ForkParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AnyValue"
    }
  },
  "thread.git": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Params naming one thread.",
      "properties": {
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId"
      ],
      "title": "ThreadRef",
      "type": "object"
    },
    "result": {
      "$defs": {
        "FileChange": {
          "description": "One changed file with its line counts.",
          "properties": {
            "additions": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "deletions": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "oldPath": {
              "description": "Previous path of a renamed file.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/FileStatus"
            }
          },
          "required": [
            "path",
            "status",
            "additions",
            "deletions"
          ],
          "type": "object"
        },
        "FileStatus": {
          "description": "Kind of change to a file.",
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "untracked"
          ],
          "type": "string"
        },
        "GitStatus": {
          "description": "Git state of a repository relative to its upstream or base ref (DMN-026).",
          "properties": {
            "ahead": {
              "description": "Commits on HEAD not in the base ref.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "baseRef": {
              "description": "What `ahead`/`behind` count against: the branch's upstream; absent without one.",
              "type": [
                "string",
                "null"
              ]
            },
            "behind": {
              "description": "Commits in the base ref not on HEAD.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "branch": {
              "description": "`None` on a detached HEAD.",
              "type": [
                "string",
                "null"
              ]
            },
            "dirty": {
              "description": "Uncommitted changes, untracked files included.",
              "type": "boolean"
            },
            "files": {
              "description": "Files changed since the base ref, committed or not.",
              "items": {
                "$ref": "#/$defs/FileChange"
              },
              "type": "array"
            }
          },
          "required": [
            "ahead",
            "behind",
            "dirty",
            "files"
          ],
          "type": "object"
        },
        "RepoStatus": {
          "description": "Git status of one repository of a workspace (the `workspace/<id>` topic, DMN-026).",
          "properties": {
            "name": {
              "description": "The repository's name in the workspace.",
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/GitStatus"
            }
          },
          "required": [
            "name",
            "status"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`thread.git` result: the git status of every repository of the thread's workspace.",
      "properties": {
        "repos": {
          "description": "In the order of the workspace's `repos`.",
          "items": {
            "$ref": "#/$defs/RepoStatus"
          },
          "type": "array"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "repos"
      ],
      "title": "ThreadGit",
      "type": "object"
    }
  },
  "thread.goal": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`thread.goal` params.",
      "properties": {
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "op": true,
        "threadId": {
          "type": "string"
        },
        "tokenBudget": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
