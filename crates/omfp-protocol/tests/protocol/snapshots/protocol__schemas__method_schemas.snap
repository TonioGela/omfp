---
source: crates/omfp-protocol/tests/protocol/schemas.rs
expression: method_schemas()
---
{
  "activity.list": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`activity.list` params (PRT-086).",
      "properties": {
        "after": {
          "description": "Only entries with a greater `seq` (newer ones).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "before": {
          "description": "Only entries with a smaller `seq` (older ones).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "limit": {
          "description": "At most this many entries; default 50, capped at 500.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "threadId": {
          "description": "Only the actions of this calling thread.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "ListActivityParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "ActivityEntry": {
          "description": "One agent-originated action (AGT-072, DMN-160).",
          "properties": {
            "at": {
              "description": "Unix milliseconds.",
              "format": "int64",
              "type": "integer"
            },
            "client": {
              "description": "The `client` of the calling principal (PRT-033): the MCP client's name when `thread_id` is `null`.",
              "type": "string"
            },
            "error": {
              "description": "`null` when the call succeeded, else the error's message.",
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "description": "The protocol method called.",
              "type": "string"
            },
            "params": {
              "description": "Its params, long strings cut to 200 characters (DMN-161)."
            },
            "seq": {
              "description": "Increasing with every entry.",
              "format": "int64",
              "type": "integer"
            },
            "threadId": {
              "description": "The thread whose agent made the call; `null` for a call of an MCP client outside omfp (PRT-094).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "seq",
            "at",
            "client",
            "method",
            "params"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`activity.list` result (PRT-086).",
      "properties": {
        "entries": {
          "description": "Newest first.",
          "items": {
            "$ref": "#/$defs/ActivityEntry"
          },
          "type": "array"
        },
        "more": {
          "description": "Entries matching the query were left out by the limit.",
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "more"
      ],
      "title": "ActivityPage",
      "type": "object"
    }
  },
  "fs.complete": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`fs.complete` params (DMN-021).",
      "properties": {
        "path": {
          "description": "An absolute path or one starting with `~`: ending with `/`, its children are listed; otherwise the children\nof its parent starting with its last segment.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "CompletePathParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "PathEntry": {
          "description": "A child directory on the daemon host, offered while typing a path (DMN-021).",
          "properties": {
            "isGitRoot": {
              "description": "The directory is the root of a git repository.",
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "path": {
              "description": "Absolute path, `~` expanded.",
              "type": "string"
            }
          },
          "required": [
            "name",
            "path",
            "isGitRoot"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`fs.complete` result: directories sorted by name, at most 200.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/PathEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "entries"
      ],
      "title": "PathCompletions",
      "type": "object"
    }
  },
  "interaction.respond": {
    "params": {
      "$defs": {
        "InteractionResponse": {
          "description": "Answer to an interactive request: exactly one of `value`, `confirmed`, `cancelled` (always true) or `answers`.",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "confirmed": {
                  "type": "boolean"
                }
              },
              "required": [
                "confirmed"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "cancelled": {
                  "const": true
                }
              },
              "required": [
                "cancelled"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "answers": {
                  "items": true,
                  "type": "array"
                }
              },
              "required": [
                "answers"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`interaction.respond` params (DMN-051).",
      "properties": {
        "interactionId": {
          "type": "string"
        },
        "response": {
          "$ref": "#/$defs/InteractionResponse"
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "interactionId",
        "response"
      ],
      "title": "RespondParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "No params, or the `{}` result.",
      "title": "Empty",
      "type": "object"
    }
  },
  "jobs.kill": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Params naming one job.",
      "properties": {
        "jobId": {
          "type": "string"
        }
      },
      "required": [
        "jobId"
      ],
      "title": "JobRef",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "No params, or the `{}` result.",
      "title": "Empty",
      "type": "object"
    }
  },
  "jobs.start": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`jobs.start` params (DMN-080).",
      "properties": {
        "command": {
          "description": "Run as `sh -c <command>` in the workspace folder.",
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "command"
      ],
      "title": "StartJobParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "JobStatus": {
          "description": "A job's process state (DMN-080).",
          "oneOf": [
            {
              "properties": {
                "state": {
                  "const": "running",
                  "type": "string"
                }
              },
              "required": [
                "state"
              ],
              "type": "object"
            },
            {
              "description": "The shell exited and both outputs closed.",
              "properties": {
                "code": {
                  "description": "Exit code; `null` when a signal ended it.",
                  "format": "int32",
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "endedAt": {
                  "format": "int64",
                  "type": "integer"
                },
                "signal": {
                  "description": "The signal that ended it, if any.",
                  "format": "int32",
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "state": {
                  "const": "exited",
                  "type": "string"
                }
              },
              "required": [
                "state",
                "endedAt"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A shell command the daemon runs for a workspace (DMN-080).",
      "properties": {
        "command": {
          "description": "Run as `sh -c <command>` in the workspace folder.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "startedAt": {
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "command",
        "startedAt",
        "status"
      ],
      "title": "JobInfo",
      "type": "object"
    }
  },
  "repos.suggest": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`repos.suggest` params (DMN-021).",
      "properties": {
        "query": {
          "description": "Keeps repositories whose path or name contains it (case-insensitive); absent or empty: all.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "SuggestReposParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "SeenRepository": {
          "description": "A repository the daemon has seen in a workspace, suggested when adding repositories (DMN-021).",
          "properties": {
            "lastSeenAt": {
              "format": "int64",
              "type": "integer"
            },
            "name": {
              "description": "The path's last component.",
              "type": "string"
            },
            "path": {
              "description": "Canonical path: a link's target or a clone, the main repository of a worktree.",
              "type": "string"
            }
          },
          "required": [
            "path",
            "name",
            "lastSeenAt"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`repos.suggest` result: most recently seen first.",
      "properties": {
        "repos": {
          "items": {
            "$ref": "#/$defs/SeenRepository"
          },
          "type": "array"
        }
      },
      "required": [
        "repos"
      ],
      "title": "RepoSuggestions",
      "type": "object"
    }
  },
  "settings.get": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "No params, or the `{}` result.",
      "title": "Empty",
      "type": "object"
    },
    "result": {
      "$defs": {
        "Density": {
          "description": "Row height and spacing of the UI.",
          "enum": [
            "compact",
            "normal"
          ],
          "type": "string"
        },
        "FontSettings": {
          "description": "CSS `font-family` values overriding the font tokens; absent ones keep the theme's.",
          "properties": {
            "code": {
              "type": [
                "string",
                "null"
              ]
            },
            "prose": {
              "type": [
                "string",
                "null"
              ]
            },
            "ui": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "KeymapEntry": {
          "description": "One key binding of the config file's `[keymap]` (UI-097).",
          "properties": {
            "command": {
              "description": "Command id; `\"\"` removes the default binding of `keys`.",
              "type": "string"
            },
            "keys": {
              "description": "Key sequence, e.g. `g g`, `Ctrl-d`, `Space n`.",
              "type": "string"
            },
            "mode": {
              "$ref": "#/$defs/KeymapMode"
            }
          },
          "required": [
            "mode",
            "keys",
            "command"
          ],
          "type": "object"
        },
        "KeymapMode": {
          "description": "The keymap mode a binding belongs to: `[keymap]`, `[keymap.insert]`, `[keymap.cmdline]`.",
          "enum": [
            "normal",
            "insert",
            "cmdline"
          ],
          "type": "string"
        },
        "Motion": {
          "description": "How much the UI animates (UI-145); `prefers-reduced-motion: reduce` caps it at `none`.",
          "oneOf": [
            {
              "const": "full",
              "description": "Every effect of the motion catalogue (default).",
              "type": "string"
            },
            {
              "const": "reduced",
              "description": "State indicators and short UI feedback only, with a steady caret.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "No animation or transition.",
              "type": "string"
            }
          ]
        },
        "NotificationMode": {
          "description": "When the UI shows system notifications (UI-096).",
          "oneOf": [
            {
              "enum": [
                "always",
                "never"
              ],
              "type": "string"
            },
            {
              "const": "background",
              "description": "Only while the window has no focus (default).",
              "type": "string"
            }
          ]
        },
        "UiSettings": {
          "description": "The `[ui]` table of the config file; an absent value is the default (UI-097).",
          "properties": {
            "density": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Density"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fontSize": {
              "description": "Root font size in px (10..=28, default 17); every rem-based size token scales with it.",
              "format": "uint8",
              "maximum": 28,
              "minimum": 10,
              "type": [
                "integer",
                "null"
              ]
            },
            "fonts": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FontSettings"
                },
                {
                  "type": "null"
                }
              ]
            },
            "motion": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Motion"
                },
                {
                  "type": "null"
                }
              ]
            },
            "notifications": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NotificationMode"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "UI settings and key bindings the daemon keeps in its config file (DMN-009, UI-097).",
      "properties": {
        "error": {
          "description": "Why the last reload of the config file failed (the previous settings stay); `null` when it is valid.",
          "type": [
            "string",
            "null"
          ]
        },
        "keymap": {
          "description": "Bindings over the defaults, in file order; `command: \"\"` removes a default binding.",
          "items": {
            "$ref": "#/$defs/KeymapEntry"
          },
          "type": "array"
        },
        "ui": {
          "$ref": "#/$defs/UiSettings"
        }
      },
      "required": [
        "ui",
        "keymap",
        "error"
      ],
      "title": "Settings",
      "type": "object"
    }
  },
  "settings.set": {
    "params": {
      "$defs": {
        "Density": {
          "description": "Row height and spacing of the UI.",
          "enum": [
            "compact",
            "normal"
          ],
          "type": "string"
        },
        "FontSettings": {
          "description": "CSS `font-family` values overriding the font tokens; absent ones keep the theme's.",
          "properties": {
            "code": {
              "type": [
                "string",
                "null"
              ]
            },
            "prose": {
              "type": [
                "string",
                "null"
              ]
            },
            "ui": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "KeymapEntry": {
          "description": "One key binding of the config file's `[keymap]` (UI-097).",
          "properties": {
            "command": {
              "description": "Command id; `\"\"` removes the default binding of `keys`.",
              "type": "string"
            },
            "keys": {
              "description": "Key sequence, e.g. `g g`, `Ctrl-d`, `Space n`.",
              "type": "string"
            },
            "mode": {
              "$ref": "#/$defs/KeymapMode"
            }
          },
          "required": [
            "mode",
            "keys",
            "command"
          ],
          "type": "object"
        },
        "KeymapMode": {
          "description": "The keymap mode a binding belongs to: `[keymap]`, `[keymap.insert]`, `[keymap.cmdline]`.",
          "enum": [
            "normal",
            "insert",
            "cmdline"
          ],
          "type": "string"
        },
        "Motion": {
          "description": "How much the UI animates (UI-145); `prefers-reduced-motion: reduce` caps it at `none`.",
          "oneOf": [
            {
              "const": "full",
              "description": "Every effect of the motion catalogue (default).",
              "type": "string"
            },
            {
              "const": "reduced",
              "description": "State indicators and short UI feedback only, with a steady caret.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "No animation or transition.",
              "type": "string"
            }
          ]
        },
        "NotificationMode": {
          "description": "When the UI shows system notifications (UI-096).",
          "oneOf": [
            {
              "enum": [
                "always",
                "never"
              ],
              "type": "string"
            },
            {
              "const": "background",
              "description": "Only while the window has no focus (default).",
              "type": "string"
            }
          ]
        },
        "UiSettings": {
          "description": "The `[ui]` table of the config file; an absent value is the default (UI-097).",
          "properties": {
            "density": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Density"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fontSize": {
              "description": "Root font size in px (10..=28, default 17); every rem-based size token scales with it.",
              "format": "uint8",
              "maximum": 28,
              "minimum": 10,
              "type": [
                "integer",
                "null"
              ]
            },
            "fonts": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FontSettings"
                },
                {
                  "type": "null"
                }
              ]
            },
            "motion": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Motion"
                },
                {
                  "type": "null"
                }
              ]
            },
            "notifications": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NotificationMode"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`settings.set` params: values merged into the config file (DMN-009); absent ones are unchanged.",
      "properties": {
        "keymap": {
          "description": "Bindings replacing the ones with the same mode and keys (`command: \"\"` unbinds the default).",
          "items": {
            "$ref": "#/$defs/KeymapEntry"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "ui": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiSettings"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[ui]` values to set; absent fields are unchanged."
        }
      },
      "title": "SetSettingsParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "Density": {
          "description": "Row height and spacing of the UI.",
          "enum": [
            "compact",
            "normal"
          ],
          "type": "string"
        },
        "FontSettings": {
          "description": "CSS `font-family` values overriding the font tokens; absent ones keep the theme's.",
          "properties": {
            "code": {
              "type": [
                "string",
                "null"
              ]
            },
            "prose": {
              "type": [
                "string",
                "null"
              ]
            },
            "ui": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "KeymapEntry": {
          "description": "One key binding of the config file's `[keymap]` (UI-097).",
          "properties": {
            "command": {
              "description": "Command id; `\"\"` removes the default binding of `keys`.",
              "type": "string"
            },
            "keys": {
              "description": "Key sequence, e.g. `g g`, `Ctrl-d`, `Space n`.",
              "type": "string"
            },
            "mode": {
              "$ref": "#/$defs/KeymapMode"
            }
          },
          "required": [
            "mode",
            "keys",
            "command"
          ],
          "type": "object"
        },
        "KeymapMode": {
          "description": "The keymap mode a binding belongs to: `[keymap]`, `[keymap.insert]`, `[keymap.cmdline]`.",
          "enum": [
