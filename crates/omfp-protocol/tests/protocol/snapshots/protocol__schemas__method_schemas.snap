      "type": "object"
    }
  },
  "views.errors": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Params naming one workspace.",
      "properties": {
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId"
      ],
      "title": "WorkspaceRef",
      "type": "object"
    },
    "result": {
      "$defs": {
        "FileErrorKind": {
          "description": "What kind of file a [`FileErrorReport`] is about (PRT-115).",
          "oneOf": [
            {
              "const": "init",
              "description": "An init file: the user's or the workspace's `.omfp/init.ts`.",
              "type": "string"
            },
            {
              "const": "view",
              "description": "A TSX view file of the workspace's `.omfp/views/`.",
              "type": "string"
            }
          ]
        },
        "FileErrorReport": {
          "description": "One runtime error a window shows of an init file or a TSX view (PRT-115).",
          "properties": {
            "file": {
              "description": "`user` for the user's init file, else the workspace-relative path (`.omfp/init.ts`, `.omfp/views/ops.tsx`).",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/FileErrorKind"
            },
            "message": {
              "description": "The error as the window shows it: a compile error with `file:line:column`, a throw, a render or layout error.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "file",
            "message"
          ],
          "type": "object"
        },
        "WindowFileErrors": {
          "description": "The init file and TSX view errors one window reports (PRT-116).",
          "properties": {
            "client": {
              "description": "The `client` of the window's `system.hello`.",
              "type": "string"
            },
            "errors": {
              "items": {
                "$ref": "#/$defs/FileErrorReport"
              },
              "type": "array"
            }
          },
          "required": [
            "client",
            "errors"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`views.errors` result (PRT-116): the latest init file and TSX view errors of every window whose\nreport is about the workspace, by connection.",
      "properties": {
        "windows": {
          "description": "One entry per window showing the workspace, those without errors included.",
          "items": {
            "$ref": "#/$defs/WindowFileErrors"
          },
          "type": "array"
        }
      },
      "required": [
        "windows"
      ],
      "title": "ViewErrors",
      "type": "object"
    }
  },
  "views.mount": {
    "params": {
      "$defs": {
        "MountPlace": {
          "description": "Where `views.mount` puts a widget in a view (PRT-080, as `omfp_view_add` does, DMN-064).",
          "oneOf": [
            {
              "const": "side_tab",
              "description": "A tab of the view's `tabs` container whose `id` prop is `side`.",
              "type": "string"
            },
            {
              "const": "main_tab",
              "description": "A tab of the view's `tabs` container whose `id` prop is `main`, after the conversation.",
              "type": "string"
            },
            {
              "const": "end",
              "description": "The end of the view's root container.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`views.mount` params (PRT-080, AGT-061): exactly one of `widget` and `code`; `panel` excludes `view` and `place`.",
      "properties": {
        "code": {
          "description": "The source of a component (TSX), written to `.omfp/widgets/<id>/index.tsx`.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "The mount id, a widget name (letters, digits, `_`, `-`, `.` not first): the node's `instance` prop, the panel\nid, and the folder `code` is written to.",
          "type": "string"
        },
        "panel": {
          "description": "Mount as a floating panel over every view (`panels.<id>`) instead.",
          "type": "boolean"
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/MountPlace"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where in the view (default: `side_tab`)."
        },
        "props": {
          "additionalProperties": true,
          "description": "The widget's props; `instance` is always the mount id.",
          "type": [
            "object",
            "null"
          ]
        },
        "view": {
          "description": "The view to mount into (default: the default view); a new id creates a view showing only the widget.",
          "type": [
            "string",
            "null"
          ]
        },
        "widget": {
          "description": "A widget reference (`./widgets/<name>`, `user:<name>`, `omfp:<name>`); a bare name means `./widgets/<name>`.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "id"
      ],
      "title": "MountParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`views.mount` and `views.mount_update` result (PRT-080, PRT-081).",
      "properties": {
        "id": {
          "type": "string"
        },
        "panel": {
          "description": "Whether it is the floating panel `id`.",
          "type": "boolean"
        },
        "reference": {
          "description": "The widget reference the node renders.",
          "type": "string"
        },
        "replaced": {
          "description": "Whether a node of this mount id existed before, or the mount's code folder did (its code was replaced).",
          "type": "boolean"
        },
        "view": {
          "description": "The view showing it; `null` for a floating panel.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "reference",
        "panel",
        "replaced"
      ],
      "title": "Mounted",
      "type": "object"
    }
  },
  "views.mount_update": {
    "params": {
