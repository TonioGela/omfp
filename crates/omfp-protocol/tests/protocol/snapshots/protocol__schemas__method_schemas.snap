  "thread.fork": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`thread.fork` params.",
      "properties": {
        "entryId": {
          "description": "Fork history through this entry; the whole session when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "threadId": {
          "type": "string"
