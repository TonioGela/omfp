  "workspaces.diff": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.diff` params.",
      "properties": {
        "cursor": {
          "description": "`nextCursor` of the previous page.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Only this file.",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "description": "The repository's name in the workspace.",
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "repo"
      ],
      "title": "WorkspaceDiffParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "FileDiff": {
          "description": "Unified diff of one file.",
          "properties": {
            "patch": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "truncated": {
              "description": "The patch was cut to fit the frame limit.",
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "patch",
            "truncated"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "One page of a workspace diff (PRT-013).",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/FileDiff"
          },
          "type": "array"
        },
        "nextCursor": {
          "description": "Pass as `cursor` to fetch the next page; absent on the last page.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "files"
      ],
      "title": "DiffPage",
      "type": "object"
    }
  },
  "workspaces.find_file": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.find_file` params (DMN-092).",
      "properties": {
        "query": {
          "description": "A bare file name (`theme.ts`) or the end of a path (`src/theme.ts`).",
          "type": "string"
        },
        "threadId": {
          "description": "A thread of the workspace: files its tool cards name rank first among candidates of the same match.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "query"
      ],
      "title": "FindFileParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "FileCandidate": {
          "description": "A file found by `workspaces.find_file` (DMN-092).",
          "properties": {
            "match": {
              "$ref": "#/$defs/FileMatch"
            },
            "mentioned": {
              "default": false,
              "description": "A tool card of the given thread names the file.",
              "type": "boolean"
            },
            "path": {
              "description": "Relative to the workspace folder (what `workspaces.read_file` takes).",
              "type": "string"
            },
            "repo": {
              "description": "The workspace repository holding the file; absent outside every repository.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "path",
            "match"
          ],
          "type": "object"
        },
        "FileMatch": {
          "description": "How a candidate of `workspaces.find_file` matches the query (DMN-092), best first.",
          "oneOf": [
            {
              "const": "exact",
              "description": "The query is the file's path relative to the workspace folder or to its repository.",
              "type": "string"
            },
            {
              "const": "suffix",
              "description": "The file's path ends with the query, which has a `/`.",
              "type": "string"
            },
            {
              "const": "basename",
              "description": "The file's name is the query's last component.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The result of `workspaces.find_file` (DMN-092): the candidates, best first.",
      "properties": {
        "candidates": {
          "description": "At most 50.",
          "items": {
            "$ref": "#/$defs/FileCandidate"
          },
          "type": "array"
        },
        "truncated": {
          "default": false,
          "description": "More files matched than were returned.",
          "type": "boolean"
        }
      },
      "required": [
        "candidates"
      ],
      "title": "FileCandidates",
      "type": "object"
    }
  },
