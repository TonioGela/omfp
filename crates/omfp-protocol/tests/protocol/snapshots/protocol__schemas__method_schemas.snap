      "$defs": {
        "ApprovalMode": {
          "description": "omp's `--approval-mode` (`tools.approvalMode`): which tool calls omp asks the user to approve (DMN-074, DMN-210).\nomp 18.18.6 exits at startup on any other value.",
          "oneOf": [
            {
              "const": "always-ask",
              "description": "Runs read tools; asks before write and exec tools.",
              "type": "string"
            },
            {
              "const": "always-ask-cached",
              "description": "Like `always-ask`, but a file read or write can be approved for a file or folder, for the session or for\ngood.",
              "type": "string"
            },
            {
              "const": "write",
              "description": "Runs read and write tools; asks before exec tools.",
              "type": "string"
            },
            {
              "const": "yolo",
              "description": "Runs every tool without asking (the default).",
              "type": "string"
            }
          ]
        }
