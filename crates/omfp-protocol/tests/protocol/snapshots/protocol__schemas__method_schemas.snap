  "workspaces.mcp_servers": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Params naming one workspace.",
      "properties": {
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId"
      ],
      "title": "WorkspaceRef",
      "type": "object"
    },
    "result": {
      "$defs": {
        "McpScope": {
          "description": "Whether a config belongs to the workspace or to the user.",
          "enum": [
            "project",
            "user"
          ],
          "type": "string"
        },
        "McpServer": {
          "description": "One MCP server configured for the workspace (PRT-113).",
          "properties": {
            "checkable": {
              "description": "omp can check the server over RPC (`/mcp test`): it comes from omp's own project or user `mcp.json`.",
              "type": "boolean"
            },
            "error": {
              "description": "Why the check failed (`failed`), as omp reported it.",
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/McpSource"
            },
            "state": {
              "$ref": "#/$defs/McpState"
            },
            "target": {
              "description": "The command of a stdio server (with its arguments), or the URL of a remote one without its query and user info.",
              "type": "string"
            },
            "tools": {
              "description": "Tools the server offered when checked (`connected`).",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "transport": {
              "$ref": "#/$defs/McpTransport"
            }
          },
          "required": [
            "name",
            "transport",
            "target",
            "source",
            "state",
            "checkable"
          ],
          "type": "object"
        },
        "McpSource": {
          "description": "Where a server is defined (PRT-113).",
          "properties": {
            "path": {
              "description": "Absolute path of the config file.",
              "type": "string"
            },
            "scope": {
              "$ref": "#/$defs/McpScope"
            },
            "tool": {
              "description": "The tool whose config it is: `omp`, `claude`, `cursor`, `vscode` (omp imports the others' files).",
              "type": "string"
            },
            "workspacePath": {
              "description": "The path relative to the workspace folder when the file is in it (a workspace file the UI can open).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "path",
            "scope",
            "tool"
          ],
          "type": "object"
        },
        "McpState": {
          "description": "A server's state as the daemon knows it (PRT-114).",
          "oneOf": [
            {
              "const": "configured",
              "description": "Configured and enabled, not checked: no thread, the thread is not running, or omp cannot check it.",
              "type": "string"
            },
            {
              "const": "connected",
              "description": "omp connected to it and listed its tools.",
              "type": "string"
            },
            {
              "const": "failed",
              "description": "omp could not connect to it or list its tools.",
              "type": "string"
            },
            {
              "const": "disabled",
              "description": "`enabled: false`, or named in the user config's `disabledServers`: omp does not load it.",
              "type": "string"
            }
          ]
        },
        "McpTransport": {
          "description": "How omp talks to a server.",
          "enum": [
            "stdio",
            "http",
            "sse"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.mcp_servers`, `thread.mcp_servers` and `thread.mcp_reconnect` result (PRT-110..PRT-112).",
      "properties": {
        "projectConfig": {
          "description": "omp's project config of the workspace, `<workspace>/.omp/mcp.json`, whether it exists or not.",
          "type": "string"
        },
        "running": {
          "description": "The thread's omp process runs: its servers were checked. `false` without a thread.",
          "type": "boolean"
        },
        "servers": {
          "description": "In omp's precedence order (the first definition of a name wins): omp's own files, then the imported ones.",
          "items": {
            "$ref": "#/$defs/McpServer"
          },
          "type": "array"
        },
        "threadId": {
          "description": "The thread whose omp checked the servers; `null` for `workspaces.mcp_servers`.",
          "type": [
            "string",
            "null"
          ]
        },
        "userConfig": {
          "description": "omp's user config, `~/.omp/agent/mcp.json`, whether it exists or not; `null` when the daemon knows no home.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "running",
        "projectConfig",
        "servers"
      ],
      "title": "McpServers",
      "type": "object"
    }
  },
  "workspaces.read_file": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.read_file` params (DMN-089).",
      "properties": {
        "knownHash": {
          "description": "The `hash` the client already shows: while the file still has it, the result is `unchanged` and carries\nneither its content nor its `HEAD` text.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Relative to the workspace folder (else to one of its repositories), or absolute inside the workspace folder.",
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "path"
      ],
      "title": "ReadFileParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "FileKind": {
          "description": "What a file of a workspace holds, as `workspaces.read_file` shows it (DMN-089).",
          "oneOf": [
            {
              "const": "text",
              "description": "UTF-8 text without NUL bytes.",
              "type": "string"
            },
            {
              "const": "image",
              "description": "An image by its extension (`png`, `jpg`, `jpeg`, `gif`, `webp`, `avif`, `bmp`, `ico`, `svg`).",
              "type": "string"
            },
            {
              "const": "binary",
              "description": "Anything else: named, never shown.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A file of a workspace (DMN-089).",
      "properties": {
        "content": {
          "description": "`text`: the text (its first 2 MiB, cut at a line end, when `truncated`); `image`: the bytes in base64 (absent\nover 8 MiB); absent for `binary` and when `unchanged`.",
          "type": [
            "string",
            "null"
          ]
        },
        "hash": {
          "description": "Hex SHA-1 of the file's bytes: the `expectedHash` of `workspaces.write_file`.",
          "type": "string"
        },
        "head": {
          "description": "The file's text at `HEAD` of that repository; absent for a file `HEAD` does not have (new, untracked), for\nbinary, truncated or `unchanged` files and outside repositories.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FileKind"
        },
        "mime": {
          "description": "The MIME type of an image.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Relative to the workspace folder, `..` resolved (symbolic links kept as they are).",
          "type": "string"
        },
        "repo": {
          "description": "The name of the workspace repository holding the file; absent outside every repository.",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "description": "Size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "description": "The text was cut (DMN-089's cap).",
          "type": "boolean"
        },
        "unchanged": {
          "default": false,
          "description": "The `knownHash` of the request still matches: no `content` and no `head`.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "kind",
        "size",
        "hash"
      ],
      "title": "FileContent",
      "type": "object"
    }
  },
  "workspaces.remove": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.remove` params (DMN-028).",
      "properties": {
        "force": {
          "default": false,
          "description": "Remove worktrees and clones even with uncommitted changes (DMN-028).",
          "type": "boolean"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId"
      ],
      "title": "RemoveWorkspaceParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "No params, or the `{}` result.",
      "title": "Empty",
      "type": "object"
    }
  },
  "workspaces.remove_repo": {
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`workspaces.remove_repo` params (DMN-025).",
      "properties": {
        "deleteBranch": {
          "default": false,
          "description": "Also delete a worktree's branch.",
          "type": "boolean"
        },
        "force": {
          "default": false,
          "description": "Remove a worktree or clone even with uncommitted changes.",
          "type": "boolean"
        },
        "name": {
          "description": "The repository's name in the workspace.",
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "name"
      ],
      "title": "RemoveRepoParams",
      "type": "object"
    },
    "result": {
      "$defs": {
        "CreatedBy": {
          "description": "The principal behind a created entity: the user, the agent of a thread, or an MCP client outside omfp (PRT-093),\nnamed by the provenance's `client`.",
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "user",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "thread",
                  "type": "string"
                },
                "threadId": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "threadId"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "mcp",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          ]
        },
        "Provenance": {
          "description": "Who created an entity (ARC-009).",
          "properties": {
            "client": {
              "description": "`client` of the creating connection's `system.hello` (PRT-033).",
              "type": [
                "string",
                "null"
              ]
            },
            "createdBy": {
              "$ref": "#/$defs/CreatedBy"
            }
          },
          "required": [
            "createdBy"
          ],
          "type": "object"
        },
        "WorkspaceRepo": {
          "description": "A repository discovered in a workspace folder (DMN-022).",
          "oneOf": [
            {
              "description": "A symlink to a repository elsewhere.",
              "properties": {
                "kind": {
                  "const": "link",
                  "type": "string"
                },
                "target": {
                  "description": "The symlink's target, as written in the link.",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "target"
              ],
              "type": "object"
            },
            {
              "description": "A linked git worktree.",
              "properties": {
                "kind": {
                  "const": "worktree",
                  "type": "string"
                },
                "main": {
                  "description": "Root of the main working tree (`git rev-parse --git-common-dir`).",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "main"
              ],
              "type": "object"
            },
            {
              "description": "A repository of its own (a clone, or a folder initialized in place).",
              "properties": {
                "kind": {
                  "const": "clone",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          ],
          "properties": {
            "branch": {
              "description": "`None` on a detached HEAD.",
              "type": [
                "string",
                "null"
              ]
            },
            "canonicalPath": {
              "description": "The checkout with symlinks resolved: entries with the same canonical path are the same files (DMN-027).",
              "type": "string"
            },
            "head": {
              "description": "Commit id of HEAD; `None` before the first commit.",
              "type": [
                "string",
                "null"
              ]
            },
            "isRoot": {
              "description": "The workspace folder itself is this repository.",
              "type": "boolean"
            },
            "name": {
              "description": "Entry name in the folder; the folder's own name for the root.",
              "type": "string"
            },
            "path": {
              "description": "Path inside the workspace (the symlink path for a link, never its target).",
              "type": "string"
            },
            "sharedWith": {
              "description": "Other workspaces holding the same checkout (same canonical path), so clients can warn (DMN-027).",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "name",
            "path",
            "isRoot",
            "canonicalPath",
            "sharedWith"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A folder threads work in; its repositories are its top-level entries (D-11, DMN-020).",
      "properties": {
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "description": "Unique among workspaces.",
          "type": "string"
        },
        "path": {
          "description": "Absolute path of the folder (under the daemon's workspaces root), unique among workspaces.",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "repos": {
          "description": "Repositories discovered in the folder (DMN-022): the folder itself first when it is a git root, then the\nentries by name.",
          "items": {
            "$ref": "#/$defs/WorkspaceRepo"
          },
          "type": "array"
        },
        "threadIds": {
          "description": "Threads living in the workspace, archived ones included, oldest first (DMN-027).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "repos",
        "threadIds",
        "provenance",
        "createdAt"
      ],
      "title": "Workspace",
      "type": "object"
    }
  },
