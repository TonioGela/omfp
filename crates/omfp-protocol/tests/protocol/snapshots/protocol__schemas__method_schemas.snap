      "type": "object"
    }
  },
  "terminal.open": {
    "params": {
      "$defs": {
        "TerminalKind": {
          "description": "What runs in a terminal (05-terminal).",
          "oneOf": [
            {
              "const": "omp",
              "description": "Interactive omp on the thread's session.",
              "type": "string"
            },
            {
              "const": "shell",
              "description": "A login shell.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`terminal.open` params (05-terminal).",
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/TerminalKind"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "threadId": {
          "description": "Required for `omp`; for `shell`, the thread whose home is the cwd.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceId": {
          "description": "For `shell`: the workspace used as cwd.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "cols",
        "rows"
      ],
      "title": "OpenTerminalParams",
      "type": "object"
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`terminal.open` result.",
      "properties": {
        "channel": {
          "description": "Binary-frame channel of this terminal on this connection.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "terminalId": {
          "type": "string"
        }
      },
      "required": [
        "terminalId",
        "channel"
      ],
      "title": "OpenTerminalResult",
      "type": "object"
    }
  },
