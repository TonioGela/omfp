    "required": [
      "repositories",
      "workspaces",
      "threads"
    ],
    "title": "IndexSnapshot",
    "type": "object"
  },
  "RepoStatus": {
    "$defs": {
      "FileChange": {
        "description": "One changed file with its line counts.",
        "properties": {
          "additions": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "deletions": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "oldPath": {
            "description": "Previous path of a renamed file.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/FileStatus"
          }
        },
        "required": [
          "path",
          "status",
          "additions",
          "deletions"
        ],
        "type": "object"
      },
      "FileStatus": {
        "description": "Kind of change to a file.",
        "enum": [
          "added",
          "modified",
          "deleted",
          "renamed",
          "untracked"
        ],
        "type": "string"
      },
      "GitStatus": {
        "description": "Git state of a repository relative to its upstream or base ref (DMN-026).",
        "properties": {
          "ahead": {
            "description": "Commits on HEAD not in the base ref.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "baseRef": {
            "description": "What `ahead`/`behind` count against: the branch's upstream; absent without one.",
            "type": [
              "string",
              "null"
            ]
          },
          "behind": {
            "description": "Commits in the base ref not on HEAD.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "branch": {
            "description": "`None` on a detached HEAD.",
            "type": [
              "string",
              "null"
            ]
          },
          "dirty": {
            "description": "Uncommitted changes, untracked files included.",
            "type": "boolean"
          },
          "files": {
            "description": "Files changed since the base ref, committed or not.",
            "items": {
              "$ref": "#/$defs/FileChange"
            },
            "type": "array"
          }
        },
        "required": [
          "ahead",
          "behind",
          "dirty",
          "files"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Git status of one repository of a workspace (the `workspace/<id>` topic, DMN-026).",
    "properties": {
      "name": {
        "description": "The repository's name in the workspace.",
        "type": "string"
      },
      "status": {
        "$ref": "#/$defs/GitStatus"
      }
    },
    "required": [
      "name",
      "status"
    ],
    "title": "RepoStatus",
    "type": "object"
  },
  "Topic": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "`index`, `thread/<id>`, `workspace/<id>` or `terminal/<id>`.",
    "pattern": "^(index|(thread|workspace|terminal)/[A-Za-z0-9_-]+)$",
    "title": "Topic",
    "type": "string"
  },
  "WorkspaceEvent": {
    "$defs": {
      "FileChange": {
        "description": "One changed file with its line counts.",
        "properties": {
          "additions": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "deletions": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "oldPath": {
            "description": "Previous path of a renamed file.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/FileStatus"
          }
        },
        "required": [
          "path",
          "status",
          "additions",
          "deletions"
        ],
        "type": "object"
      },
      "FileStatus": {
        "description": "Kind of change to a file.",
        "enum": [
          "added",
          "modified",
          "deleted",
          "renamed",
          "untracked"
        ],
        "type": "string"
      },
      "GitStatus": {
        "description": "Git state of a repository relative to its upstream or base ref (DMN-026).",
        "properties": {
          "ahead": {
            "description": "Commits on HEAD not in the base ref.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "baseRef": {
            "description": "What `ahead`/`behind` count against: the branch's upstream; absent without one.",
            "type": [
              "string",
              "null"
            ]
          },
          "behind": {
            "description": "Commits in the base ref not on HEAD.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "branch": {
            "description": "`None` on a detached HEAD.",
            "type": [
              "string",
              "null"
            ]
          },
          "dirty": {
            "description": "Uncommitted changes, untracked files included.",
            "type": "boolean"
          },
          "files": {
            "description": "Files changed since the base ref, committed or not.",
            "items": {
              "$ref": "#/$defs/FileChange"
            },
            "type": "array"
          }
        },
        "required": [
          "ahead",
          "behind",
          "dirty",
          "files"
        ],
        "type": "object"
      },
      "RepoStatus": {
        "description": "Git status of one repository of a workspace (the `workspace/<id>` topic, DMN-026).",
        "properties": {
          "name": {
            "description": "The repository's name in the workspace.",
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/GitStatus"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Change on a `workspace/<id>` topic, whose state is the git status of each repository of the workspace.",
    "oneOf": [
      {
        "description": "The git status of the workspace's repositories changed; replaces the previous list.",
        "properties": {
          "kind": {
            "const": "status",
            "type": "string"
          },
          "repos": {
            "items": {
              "$ref": "#/$defs/RepoStatus"
            },
            "type": "array"
          }
        },
        "required": [
          "kind",
          "repos"
        ],
        "type": "object"
      }
    ],
    "title": "WorkspaceEvent"
  }
}
