            "anyOf": [
              {
                "$ref": "#/$defs/NotificationMode"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "Workspace": {
        "description": "A folder threads work in; its repositories are its top-level entries (D-11, DMN-020).",
        "properties": {
          "createdAt": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "description": "Unique among workspaces.",
            "type": "string"
          },
          "path": {
            "description": "Absolute path of the folder (under the daemon's workspaces root), unique among workspaces.",
            "type": "string"
          },
          "provenance": {
            "$ref": "#/$defs/Provenance"
          },
          "repos": {
            "description": "Repositories discovered in the folder (DMN-022): the folder itself first when it is a git root, then the\nentries by name.",
            "items": {
              "$ref": "#/$defs/WorkspaceRepo"
            },
            "type": "array"
          },
          "threadIds": {
            "description": "Threads living in the workspace, archived ones included, oldest first (DMN-027).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "path",
          "repos",
          "threadIds",
          "provenance",
          "createdAt"
        ],
        "type": "object"
      },
      "WorkspaceRepo": {
        "description": "A repository discovered in a workspace folder (DMN-022).",
        "oneOf": [
          {
            "description": "A symlink to a repository elsewhere.",
            "properties": {
              "kind": {
                "const": "link",
                "type": "string"
              },
              "target": {
                "description": "The symlink's target, as written in the link.",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "target"
            ],
            "type": "object"
          },
          {
            "description": "A linked git worktree.",
            "properties": {
              "kind": {
                "const": "worktree",
                "type": "string"
              },
              "main": {
                "description": "Root of the main working tree (`git rev-parse --git-common-dir`).",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "main"
            ],
            "type": "object"
          },
          {
            "description": "A repository of its own (a clone, or a folder initialized in place).",
            "properties": {
              "kind": {
                "const": "clone",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "branch": {
            "description": "`None` on a detached HEAD.",
            "type": [
              "string",
              "null"
            ]
          },
          "canonicalPath": {
            "description": "The checkout with symlinks resolved: entries with the same canonical path are the same files (DMN-027).",
            "type": "string"
          },
          "head": {
            "description": "Commit id of HEAD; `None` before the first commit.",
            "type": [
              "string",
              "null"
            ]
          },
          "isRoot": {
            "description": "The workspace folder itself is this repository.",
            "type": "boolean"
          },
          "name": {
            "description": "Entry name in the folder; the folder's own name for the root.",
            "type": "string"
          },
          "path": {
            "description": "Path inside the workspace (the symlink path for a link, never its target).",
            "type": "string"
          },
          "sharedWith": {
            "description": "Other workspaces holding the same checkout (same canonical path), so clients can warn (DMN-027).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "path",
          "isRoot",
          "canonicalPath",
          "sharedWith"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "State of the `index` topic.",
    "properties": {
      "settings": {
        "$ref": "#/$defs/Settings"
      },
      "theme": {
        "$ref": "#/$defs/Theme"
      },
      "threads": {
        "items": {
          "$ref": "#/$defs/ThreadSummary"
        },
        "type": "array"
      },
      "workspaces": {
        "items": {
          "$ref": "#/$defs/Workspace"
        },
        "type": "array"
      }
    },
    "required": [
      "workspaces",
      "threads",
      "theme",
      "settings"
    ],
    "title": "IndexSnapshot",
    "type": "object"
  },
  "JobEvent": {
    "$defs": {
      "JobStream": {
        "description": "Which output of a job a line comes from.",
        "enum": [
          "stdout",
          "stderr"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Change on a `job/<id>` topic, whose state is a `JobState` (PRT-041).",
    "oneOf": [
      {
        "description": "One more output line.",
        "properties": {
          "kind": {
            "const": "job_output",
            "type": "string"
          },
          "stream": {
            "$ref": "#/$defs/JobStream"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "stream",
          "text"
        ],
        "type": "object"
      },
      {
        "description": "The shell exited and both outputs closed.",
        "properties": {
          "code": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "endedAt": {
            "format": "int64",
            "type": "integer"
          },
          "kind": {
            "const": "job_exited",
            "type": "string"
          },
          "signal": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "endedAt"
        ],
        "type": "object"
      }
    ],
    "title": "JobEvent"
  },
  "JobState": {
    "$defs": {
      "JobInfo": {
        "description": "A shell command the daemon runs for a workspace (DMN-080).",
        "properties": {
          "command": {
            "description": "Run as `sh -c <command>` in the workspace folder.",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "startedAt": {
            "format": "int64",
            "type": "integer"
          },
          "status": {
            "$ref": "#/$defs/JobStatus"
          },
          "workspaceId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "workspaceId",
          "command",
          "startedAt",
          "status"
        ],
        "type": "object"
      },
      "JobLine": {
        "description": "One output line of a job, without its line break.",
        "properties": {
          "stream": {
            "$ref": "#/$defs/JobStream"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "stream",
          "text"
        ],
        "type": "object"
      },
      "JobStatus": {
        "description": "A job's process state (DMN-080).",
        "oneOf": [
          {
            "properties": {
              "state": {
                "const": "running",
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "description": "The shell exited and both outputs closed.",
            "properties": {
              "code": {
                "description": "Exit code; `null` when a signal ended it.",
                "format": "int32",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "endedAt": {
                "format": "int64",
                "type": "integer"
              },
              "signal": {
                "description": "The signal that ended it, if any.",
                "format": "int32",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "state": {
                "const": "exited",
                "type": "string"
              }
            },
            "required": [
              "state",
              "endedAt"
            ],
            "type": "object"
          }
        ]
      },
      "JobStream": {
        "description": "Which output of a job a line comes from.",
        "enum": [
          "stdout",
          "stderr"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "State of a `job/<id>` topic (PRT-041).",
    "properties": {
      "dropped": {
        "description": "How many older lines were left out.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "job": {
        "$ref": "#/$defs/JobInfo"
      },
      "lines": {
        "description": "The newest lines, at most 1 MiB of text, oldest first.",
        "items": {
          "$ref": "#/$defs/JobLine"
        },
        "type": "array"
      }
    },
    "required": [
      "job",
      "lines",
      "dropped"
    ],
    "title": "JobState",
    "type": "object"
  },
  "RepoStatus": {
    "$defs": {
      "FileChange": {
        "description": "One changed file with its line counts.",
        "properties": {
          "additions": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "deletions": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "oldPath": {
            "description": "Previous path of a renamed file.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/FileStatus"
          }
        },
        "required": [
          "path",
          "status",
          "additions",
          "deletions"
        ],
        "type": "object"
      },
      "FileStatus": {
        "description": "Kind of change to a file.",
        "enum": [
          "added",
          "modified",
          "deleted",
          "renamed",
          "untracked"
        ],
        "type": "string"
      },
      "GitStatus": {
        "description": "Git state of a repository relative to its upstream or base ref (DMN-026).",
        "properties": {
          "ahead": {
            "description": "Commits on HEAD not in the base ref.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "baseRef": {
            "description": "What `ahead`/`behind` count against: the branch's upstream; absent without one.",
            "type": [
              "string",
              "null"
            ]
          },
          "behind": {
            "description": "Commits in the base ref not on HEAD.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "branch": {
            "description": "`None` on a detached HEAD.",
            "type": [
              "string",
              "null"
            ]
          },
          "dirty": {
            "description": "Uncommitted changes, untracked files included.",
            "type": "boolean"
          },
          "files": {
            "description": "Files changed since the base ref, committed or not.",
            "items": {
              "$ref": "#/$defs/FileChange"
            },
            "type": "array"
          }
        },
        "required": [
          "ahead",
          "behind",
          "dirty",
          "files"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Git status of one repository of a workspace (the `workspace/<id>` topic, DMN-026).",
    "properties": {
      "name": {
        "description": "The repository's name in the workspace.",
        "type": "string"
      },
      "status": {
        "$ref": "#/$defs/GitStatus"
      }
    },
    "required": [
      "name",
      "status"
    ],
    "title": "RepoStatus",
    "type": "object"
  },
  "Topic": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "`index`, `thread/<id>`, `workspace/<id>`, `terminal/<id>`, `views/<id>` or `job/<id>`.",
    "pattern": "^(index|(thread|workspace|terminal|views|job)/[A-Za-z0-9_-]+)$",
    "title": "Topic",
    "type": "string"
  },
  "TransientEvent": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The `event` of a transient frame (PRT-054).",
    "oneOf": [
      {
        "description": "omp's `live_levels` of a `live_start` session on `thread/<id>` (DMN-110): microphone (`input`) and speaker\n(`output`) RMS in [0, 1], at most ten a second.",
        "properties": {
          "input": {
            "format": "double",
            "type": "number"
          },
          "kind": {
            "const": "live_levels",
            "type": "string"
          },
          "output": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "input",
          "output"
        ],
        "type": "object"
      }
    ],
    "title": "TransientEvent"
  },
  "ViewsEvent": {
    "$defs": {
      "WidgetInfo": {
        "description": "A widget folder the daemon serves (DMN-082).",
        "properties": {
          "entry": {
            "description": "The entry file (`index.tsx`, `index.ts`, `index.jsx` or `index.js`, the first present); `null` without one.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The folder's name.",
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/WidgetSource"
          },
          "version": {
            "description": "Hash of the relative path, size and modification time of every file in the folder: changes with every save.",
            "type": "string"
          }
        },
        "required": [
          "source",
          "name",
          "version"
        ],
        "type": "object"
      },
      "WidgetSource": {
        "description": "Where a widget folder lives (AGT-012, AGT-023).",
        "oneOf": [
          {
            "const": "workspace",
            "description": "`<workspace>/.omfp/widgets/<name>/`, referenced as `./widgets/<name>`.",
            "type": "string"
          },
          {
            "const": "user",
            "description": "`<data-dir>/widgets/<name>/`, referenced as `user:<name>`.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Change on a `views/<workspaceId>` topic, whose state is a `ViewsState` (PRT-040).",
    "oneOf": [
      {
        "description": "The manifest changed: replaces `manifest` and `error`.",
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "const": "views_manifest",
            "type": "string"
          },
          "manifest": true
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      {
        "description": "A widget folder appeared, changed or went away: replaces `widgets`.",
        "properties": {
          "kind": {
            "const": "views_widgets",
            "type": "string"
          },
          "widgets": {
            "items": {
              "$ref": "#/$defs/WidgetInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "kind",
          "widgets"
        ],
        "type": "object"
      },
      {
        "description": "A widget stored a value (`null`: removed the key, DMN-086).",
        "properties": {
          "instance": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "kind": {
            "const": "widget_stored",
            "type": "string"
          },
          "value": true
        },
        "required": [
          "kind",
          "instance",
          "key",
          "value"
        ],
        "type": "object"
      }
    ],
    "title": "ViewsEvent"
  },
  "ViewsState": {
    "$defs": {
      "WidgetInfo": {
        "description": "A widget folder the daemon serves (DMN-082).",
        "properties": {
          "entry": {
            "description": "The entry file (`index.tsx`, `index.ts`, `index.jsx` or `index.js`, the first present); `null` without one.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The folder's name.",
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/WidgetSource"
          },
          "version": {
            "description": "Hash of the relative path, size and modification time of every file in the folder: changes with every save.",
            "type": "string"
          }
        },
        "required": [
          "source",
          "name",
          "version"
        ],
        "type": "object"
      },
      "WidgetSource": {
        "description": "Where a widget folder lives (AGT-012, AGT-023).",
        "oneOf": [
          {
            "const": "workspace",
            "description": "`<workspace>/.omfp/widgets/<name>/`, referenced as `./widgets/<name>`.",
            "type": "string"
          },
          {
            "const": "user",
            "description": "`<data-dir>/widgets/<name>/`, referenced as `user:<name>`.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "State of a `views/<workspaceId>` topic (PRT-040, DMN-082).",
    "properties": {
      "error": {
        "description": "Why the file is refused (`<JSON path>: <reason>`, or why it cannot be read); `null` when valid or absent.",
        "type": [
          "string",
          "null"
        ]
      },
      "manifest": {
        "description": "The workspace's `.omfp/views.json` when it is a valid manifest (AGT-010); `null` without a file or when invalid."
      },
      "stored": {
        "additionalProperties": {
          "additionalProperties": true,
          "type": "object"
        },
        "description": "What widgets stored with `useStored` (DMN-086): instance → key → value.",
        "type": "object"
      },
      "widgets": {
        "description": "Widget folders of the workspace, then of the user library, each by name.",
        "items": {
          "$ref": "#/$defs/WidgetInfo"
        },
        "type": "array"
      }
    },
    "required": [
      "widgets",
      "stored"
    ],
    "title": "ViewsState",
    "type": "object"
  },
  "WorkspaceEvent": {
    "$defs": {
      "FileChange": {
        "description": "One changed file with its line counts.",
        "properties": {
          "additions": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "deletions": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "oldPath": {
            "description": "Previous path of a renamed file.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/FileStatus"
          }
        },
        "required": [
          "path",
          "status",
          "additions",
          "deletions"
        ],
        "type": "object"
      },
      "FileStatus": {
        "description": "Kind of change to a file.",
        "enum": [
          "added",
          "modified",
          "deleted",
          "renamed",
          "untracked"
        ],
        "type": "string"
      },
      "GitStatus": {
        "description": "Git state of a repository relative to its upstream or base ref (DMN-026).",
        "properties": {
          "ahead": {
            "description": "Commits on HEAD not in the base ref.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "baseRef": {
            "description": "What `ahead`/`behind` count against: the branch's upstream; absent without one.",
            "type": [
              "string",
              "null"
            ]
          },
          "behind": {
            "description": "Commits in the base ref not on HEAD.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "branch": {
            "description": "`None` on a detached HEAD.",
            "type": [
              "string",
              "null"
            ]
          },
          "dirty": {
            "description": "Uncommitted changes, untracked files included.",
            "type": "boolean"
          },
          "files": {
            "description": "Files changed since the base ref, committed or not.",
            "items": {
              "$ref": "#/$defs/FileChange"
            },
            "type": "array"
          }
        },
        "required": [
          "ahead",
          "behind",
          "dirty",
          "files"
        ],
        "type": "object"
      },
      "RepoStatus": {
        "description": "Git status of one repository of a workspace (the `workspace/<id>` topic, DMN-026).",
        "properties": {
          "name": {
            "description": "The repository's name in the workspace.",
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/GitStatus"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Change on a `workspace/<id>` topic, whose state is the git status of each repository of the workspace.",
    "oneOf": [
      {
        "description": "The git status of the workspace's repositories changed; replaces the previous list.",
        "properties": {
          "kind": {
            "const": "status",
            "type": "string"
          },
          "repos": {
            "items": {
              "$ref": "#/$defs/RepoStatus"
            },
            "type": "array"
          }
        },
        "required": [
          "kind",
          "repos"
        ],
        "type": "object"
      }
    ],
    "title": "WorkspaceEvent"
  }
}
