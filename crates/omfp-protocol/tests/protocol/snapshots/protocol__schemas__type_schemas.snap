          },
          "defaultBaseRef": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "description": "Absolute path of the repository root.",
            "type": "string"
          },
          "remoteUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "path",
          "defaultBaseRef",
          "createdAt"
        ],
        "type": "object"
      },
      "ThreadSummary": {
        "description": "What the thread list shows about a thread.",
        "properties": {
          "archivedAt": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "createdAt": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "needsAttention": {
            "description": "Interactive requests are waiting for an answer.",
            "type": "boolean"
          },
          "process": {
            "description": "`omfp_core::ProcessState`."
          },
          "provenance": {
            "$ref": "#/$defs/Provenance"
          },
          "settled": {
            "description": "Idle with nothing queued or pending (omp's `session_settled`).",
            "type": "boolean"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "format": "int64",
