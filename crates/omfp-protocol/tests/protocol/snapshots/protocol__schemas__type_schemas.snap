---
source: crates/omfp-protocol/tests/protocol/schemas.rs
expression: type_schemas()
---
{
  "ErrorBody": {
    "$defs": {
      "ErrorCode": {
        "description": "Error codes (PRT-011); a closed set.",
        "oneOf": [
          {
            "enum": [
              "unauthorized",
              "bad_request",
              "not_found",
              "conflict",
              "already_resolved",
              "limit_reached",
              "version_mismatch",
              "thread_failed",
              "git_error",
              "internal"
            ],
            "type": "string"
          },
          {
            "const": "omp_error",
            "description": "omp refused the command; its own code is in `ompCode` (DMN-071).",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The `error` of a failed response.",
    "properties": {
      "code": {
        "$ref": "#/$defs/ErrorCode"
      },
      "details": true,
      "message": {
        "type": "string"
      },
      "ompCode": {
        "description": "omp's `code`, for `omp_error`.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "code",
      "message"
    ],
    "title": "ErrorBody",
    "type": "object"
  },
  "ErrorCode": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Error codes (PRT-011); a closed set.",
    "oneOf": [
      {
        "enum": [
          "unauthorized",
          "bad_request",
          "not_found",
          "conflict",
          "already_resolved",
          "limit_reached",
          "version_mismatch",
          "thread_failed",
          "git_error",
          "internal"
        ],
        "type": "string"
      },
      {
        "const": "omp_error",
        "description": "omp refused the command; its own code is in `ompCode` (DMN-071).",
        "type": "string"
      }
    ],
    "title": "ErrorCode"
  },
  "IndexEvent": {
    "$defs": {
      "CreatedBy": {
        "description": "The principal behind a created entity: the user, or the agent of a thread.",
        "oneOf": [
          {
            "properties": {
              "kind": {
                "const": "user",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "const": "thread",
                "type": "string"
              },
              "threadId": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "threadId"
            ],
            "type": "object"
          }
        ]
      },
      "Density": {
        "description": "Row height and spacing of the UI.",
        "enum": [
          "compact",
          "normal"
        ],
        "type": "string"
      },
      "FontSettings": {
        "description": "CSS `font-family` values overriding the font tokens; absent ones keep the theme's.",
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "prose": {
            "type": [
              "string",
              "null"
            ]
          },
          "ui": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "KeymapEntry": {
        "description": "One key binding of the config file's `[keymap]` (UI-097).",
        "properties": {
          "command": {
            "description": "Command id; `\"\"` removes the default binding of `keys`.",
            "type": "string"
          },
          "keys": {
            "description": "Key sequence, e.g. `g g`, `Ctrl-d`, `Space n`.",
            "type": "string"
          },
          "mode": {
            "$ref": "#/$defs/KeymapMode"
          }
        },
        "required": [
          "mode",
          "keys",
          "command"
        ],
        "type": "object"
      },
      "KeymapMode": {
        "description": "The keymap mode a binding belongs to: `[keymap]`, `[keymap.insert]`, `[keymap.cmdline]`.",
        "enum": [
          "normal",
          "insert",
          "cmdline"
        ],
        "type": "string"
      },
      "Motion": {
        "description": "How much the UI animates (UI-145); `prefers-reduced-motion: reduce` caps it at `none`.",
        "oneOf": [
          {
            "const": "full",
            "description": "Every effect of the motion catalogue (default).",
            "type": "string"
          },
          {
            "const": "reduced",
            "description": "State indicators and short UI feedback only, with a steady caret.",
            "type": "string"
          },
          {
            "const": "none",
            "description": "No animation or transition.",
            "type": "string"
          }
        ]
      },
      "NotificationMode": {
        "description": "When the UI shows system notifications (UI-096).",
        "oneOf": [
          {
            "enum": [
              "always",
              "never"
            ],
            "type": "string"
          },
          {
            "const": "background",
            "description": "Only while the window has no focus (default).",
            "type": "string"
          }
        ]
      },
      "Provenance": {
        "description": "Who created an entity (ARC-009).",
        "properties": {
          "client": {
            "description": "`client` of the creating connection's `system.hello` (PRT-033).",
            "type": [
              "string",
              "null"
            ]
          },
          "createdBy": {
            "$ref": "#/$defs/CreatedBy"
          }
        },
        "required": [
          "createdBy"
        ],
        "type": "object"
      },
      "Settings": {
        "description": "UI settings and key bindings the daemon keeps in its config file (DMN-009, UI-097).",
        "properties": {
          "error": {
            "description": "Why the last reload of the config file failed (the previous settings stay); `null` when it is valid.",
            "type": [
              "string",
              "null"
            ]
          },
          "keymap": {
            "description": "Bindings over the defaults, in file order; `command: \"\"` removes a default binding.",
            "items": {
              "$ref": "#/$defs/KeymapEntry"
            },
            "type": "array"
          },
          "ui": {
            "$ref": "#/$defs/UiSettings"
          }
        },
        "required": [
          "ui",
          "keymap",
          "error"
        ],
        "type": "object"
      },
      "Theme": {
        "description": "The user's theme: CSS applied after the built-in tokens (DMN-075).",
        "properties": {
          "css": {
            "description": "`null`: the built-in themes only.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "css"
        ],
        "type": "object"
      },
      "ThreadSummary": {
        "description": "What the thread list shows about a thread.",
        "properties": {
          "archivedAt": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "createdAt": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "needsAttention": {
            "description": "Interactive requests are waiting for an answer.",
            "type": "boolean"
          },
          "process": {
            "description": "`omfp_core::ProcessState`."
          },
          "provenance": {
            "$ref": "#/$defs/Provenance"
          },
          "settled": {
            "description": "Idle with nothing queued or pending (omp's `session_settled`).",
            "type": "boolean"
          },
          "title": {
            "description": "`\"\"` until the first message (DMN-073).",
            "type": "string"
          },
          "titleSource": {
            "$ref": "#/$defs/TitleSource"
          },
          "updatedAt": {
            "format": "int64",
            "type": "integer"
          },
          "workspaceId": {
            "description": "The workspace the thread lives in: its omp cwd (ARC-008, DMN-029).",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "titleSource",
          "workspaceId",
          "process",
          "settled",
          "needsAttention",
          "provenance",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "TitleSource": {
        "description": "Where a thread's title comes from (DMN-073).",
        "oneOf": [
          {
            "const": "placeholder",
            "description": "The first words of the first message (or `\"\"` before it), until a title is generated or set.",
            "type": "string"
          },
          {
            "const": "generated",
            "description": "Generated from the conversation by the daemon.",
            "type": "string"
          },
          {
            "const": "set",
            "description": "Set by the user or an agent (`threads.create`, `threads.update`, host tool `set_thread_title`); never replaced.",
            "type": "string"
          }
        ]
      },
      "UiSettings": {
        "description": "The `[ui]` table of the config file; an absent value is the default (UI-097).",
        "properties": {
          "density": {
            "anyOf": [
              {
                "$ref": "#/$defs/Density"
              },
              {
                "type": "null"
              }
            ]
          },
          "fontSize": {
            "description": "Root font size in px (10..=28, default 17); every rem-based size token scales with it.",
            "format": "uint8",
            "maximum": 28,
            "minimum": 10,
            "type": [
              "integer",
              "null"
            ]
          },
          "fonts": {
            "anyOf": [
              {
                "$ref": "#/$defs/FontSettings"
              },
              {
                "type": "null"
              }
            ]
          },
          "motion": {
            "anyOf": [
              {
                "$ref": "#/$defs/Motion"
              },
              {
                "type": "null"
              }
            ]
          },
          "notifications": {
            "anyOf": [
              {
                "$ref": "#/$defs/NotificationMode"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "Workspace": {
        "description": "A folder threads work in; its repositories are its top-level entries (D-11, DMN-020).",
        "properties": {
          "createdAt": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "description": "Unique among workspaces.",
            "type": "string"
          },
          "path": {
            "description": "Absolute path of the folder (under the daemon's workspaces root), unique among workspaces.",
            "type": "string"
          },
          "provenance": {
            "$ref": "#/$defs/Provenance"
          },
          "repos": {
            "description": "Repositories discovered in the folder (DMN-022): the folder itself first when it is a git root, then the\nentries by name.",
            "items": {
              "$ref": "#/$defs/WorkspaceRepo"
            },
            "type": "array"
          },
          "threadIds": {
            "description": "Threads living in the workspace, archived ones included, oldest first (DMN-027).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "path",
          "repos",
          "threadIds",
          "provenance",
          "createdAt"
        ],
        "type": "object"
      },
      "WorkspaceRepo": {
        "description": "A repository discovered in a workspace folder (DMN-022).",
        "oneOf": [
          {
            "description": "A symlink to a repository elsewhere.",
            "properties": {
              "kind": {
                "const": "link",
                "type": "string"
              },
              "target": {
                "description": "The symlink's target, as written in the link.",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "target"
            ],
            "type": "object"
          },
          {
            "description": "A linked git worktree.",
            "properties": {
              "kind": {
                "const": "worktree",
                "type": "string"
              },
              "main": {
                "description": "Root of the main working tree (`git rev-parse --git-common-dir`).",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "main"
            ],
            "type": "object"
          },
          {
            "description": "A repository of its own (a clone, or a folder initialized in place).",
            "properties": {
              "kind": {
                "const": "clone",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "branch": {
            "description": "`None` on a detached HEAD.",
            "type": [
              "string",
              "null"
            ]
          },
          "canonicalPath": {
            "description": "The checkout with symlinks resolved: entries with the same canonical path are the same files (DMN-027).",
            "type": "string"
          },
          "head": {
            "description": "Commit id of HEAD; `None` before the first commit.",
            "type": [
              "string",
              "null"
            ]
          },
          "isRoot": {
            "description": "The workspace folder itself is this repository.",
            "type": "boolean"
          },
          "name": {
            "description": "Entry name in the folder; the folder's own name for the root.",
            "type": "string"
          },
          "path": {
            "description": "Path inside the workspace (the symlink path for a link, never its target).",
            "type": "string"
          },
          "sharedWith": {
            "description": "Other workspaces holding the same checkout (same canonical path), so clients can warn (DMN-027).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "path",
          "isRoot",
          "canonicalPath",
          "sharedWith"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Change on the `index` topic.",
    "oneOf": [
      {
        "properties": {
          "kind": {
            "const": "workspace_upserted",
            "type": "string"
          },
          "workspace": {
            "$ref": "#/$defs/Workspace"
          }
        },
        "required": [
          "kind",
          "workspace"
        ],
        "type": "object"
      },
      {
        "properties": {
          "kind": {
            "const": "workspace_removed",
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "workspaceId"
        ],
        "type": "object"
      },
      {
        "properties": {
          "kind": {
            "const": "thread_upserted",
            "type": "string"
          },
          "thread": {
            "$ref": "#/$defs/ThreadSummary"
          }
        },
        "required": [
          "kind",
          "thread"
        ],
        "type": "object"
      },
      {
        "properties": {
          "kind": {
            "const": "thread_removed",
            "type": "string"
          },
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "threadId"
        ],
        "type": "object"
      },
      {
        "description": "The user's theme changed (DMN-075).",
        "properties": {
          "kind": {
            "const": "theme_changed",
            "type": "string"
          },
          "theme": {
            "$ref": "#/$defs/Theme"
          }
        },
        "required": [
          "kind",
          "theme"
        ],
        "type": "object"
      },
      {
        "description": "The UI settings of the config file changed (DMN-009, UI-097).",
        "properties": {
          "kind": {
            "const": "settings_changed",
            "type": "string"
          },
          "settings": {
            "$ref": "#/$defs/Settings"
          }
        },
        "required": [
          "kind",
          "settings"
        ],
        "type": "object"
      }
    ],
    "title": "IndexEvent"
  },
  "IndexSnapshot": {
