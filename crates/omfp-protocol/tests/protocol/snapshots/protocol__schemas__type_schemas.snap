        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "State of the `index` topic.",
    "properties": {
      "repositories": {
        "items": {
          "$ref": "#/$defs/Repository"
        },
        "type": "array"
      },
      "threads": {
        "items": {
          "$ref": "#/$defs/ThreadSummary"
        },
