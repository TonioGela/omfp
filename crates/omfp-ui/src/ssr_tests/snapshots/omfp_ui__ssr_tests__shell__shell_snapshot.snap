---
source: crates/omfp-ui/src/ssr_tests/shell.rs
expression: "normalize(&render(input, ui))"
---
<div class="app" data-testid="app">
<div class="shell" data-testid="shell">
<nav class="sidebar" aria-label="Threads" data-testid="sidebar">
<div class="sidebar-actions">
<button type="button" data-testid="new-thread" title="New thread (Alt+N)">+ thread</button>
<button type="button" data-testid="next-attention" title="Next thread needing attention (Alt+A)">Next waiting (1)</button>
</div>
<div class="sidebar-controls">
<label>Group <select data-testid="grouping" value="repository">
<option value="none">none</option>
<option value="tag">tag</option>
<option value="workspace">workspace</option>
<option value="repository" selected=true>repository</option>
<option value="pr">pr</option>
</select>
</label>
<label>Filter <select data-testid="filter-key" value="">
<option value="">all</option>
<option value="tag:release">tag: release</option>
<option value="workspace:w-be2">workspace: be:flaky</option>
<option value="workspace:w-be">workspace: be:main</option>
<option value="workspace:w-fe">workspace: fe:feat/checkout</option>
<option value="workspace:w-adopted">workspace: w-adopted</option>
<option value="repository:r-be">repository: be</option>
<option value="repository:r-fe">repository: fe</option>
<option value="pr:fe#412">pr: fe#412</option>
</select>
</label>
<input type="search" data-testid="filter-text" aria-label="Search threads" placeholder="Search threads" value=""/>
</div>
<section class="thread-group" data-testid="thread-group" data-group="r-be">
<h3 class="group-label">be</h3>
<ul class="thread-list">
<li>
<button type="button" class="thread-row" data-testid="thread-row" data-thread-id="t-checkout" data-status="awaiting">
<span class="badge status-awaiting" data-testid="thread-status" data-status="awaiting" title="awaiting input">
<span aria-hidden="true">!</span>
<span class="sr-only">awaiting input</span>
</span>
<span class="thread-title">checkout-v2</span>
<span class="chips">
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-fe" data-cwd=true title="Working directory">
<span class="chip-cwd" aria-label="cwd">⌂</span>fe:feat/checkout<span class="chip-pr">#412</span>
</span>
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-be" data-cwd=false title="Workspace">be:main</span>
</span>
</button>
</li>
<li>
<button type="button" class="thread-row" data-testid="thread-row" data-thread-id="t-flaky" data-status="running">
<span class="badge status-running" data-testid="thread-status" data-status="running" title="running">
<span aria-hidden="true">◐</span>
<span class="sr-only">running</span>
</span>
<span class="thread-title">flaky-tests</span>
<span class="chips">
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-be" data-cwd=true title="Working directory">
<span class="chip-cwd" aria-label="cwd">⌂</span>be:main</span>
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-be2" data-cwd=false title="Workspace">be:flaky</span>
</span>
</button>
</li>
</ul>
</section>
<section class="thread-group" data-testid="thread-group" data-group="r-fe">
<h3 class="group-label">fe</h3>
<ul class="thread-list">
<li>
<button type="button" class="thread-row" data-testid="thread-row" data-thread-id="t-checkout" data-status="awaiting">
<span class="badge status-awaiting" data-testid="thread-status" data-status="awaiting" title="awaiting input">
<span aria-hidden="true">!</span>
<span class="sr-only">awaiting input</span>
</span>
<span class="thread-title">checkout-v2</span>
<span class="chips">
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-fe" data-cwd=true title="Working directory">
<span class="chip-cwd" aria-label="cwd">⌂</span>fe:feat/checkout<span class="chip-pr">#412</span>
</span>
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-be" data-cwd=false title="Workspace">be:main</span>
</span>
</button>
</li>
</ul>
</section>
<section class="thread-group" data-testid="thread-group" data-group="">
<h3 class="group-label">No repository</h3>
<ul class="thread-list">
<li>
<button type="button" class="thread-row" data-testid="thread-row" data-thread-id="t-scratch" data-status="failed">
<span class="badge status-failed" data-testid="thread-status" data-status="failed" title="failed">
<span aria-hidden="true">✕</span>
<span class="sr-only">failed</span>
</span>
<span class="thread-title">scratch</span>
</button>
</li>
<li>
<button type="button" class="thread-row" data-testid="thread-row" data-thread-id="t-idle" data-status="idle">
<span class="badge status-idle" data-testid="thread-status" data-status="idle" title="idle">
<span aria-hidden="true">●</span>
<span class="sr-only">idle</span>
</span>
<span class="thread-title">idle-notes</span>
<span class="unread" data-testid="unread" aria-label="unread">•</span>
<span class="chips">
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-adopted" data-cwd=true title="Working directory">
<span class="chip-cwd" aria-label="cwd">⌂</span>w-adopted</span>
</span>
</button>
</li>
</ul>
</section>
<div class="sidebar-footer">
<label>Theme <select data-testid="theme" value="system">
<option value="system" selected=true>System</option>
<option value="light">Light</option>
<option value="dark">Dark</option>
</select>
</label>
</div>
</nav>
<main class="main" data-testid="main">
<div class="empty" data-testid="no-thread">Select a thread, or create one with “+ thread”.</div>
</main>
<aside class="side" data-testid="side-panels" aria-label="Panels">
<section class="panel" data-testid="panel" data-panel="workspaces" data-kind="workspaces" data-placement="side" aria-label="Workspaces">
<div class="panel-header">
<h2>Workspaces</h2>
<select data-testid="panel-placement" aria-label="Move the Workspaces panel" value="side">
<option value="side" selected=true>Side</option>
<option value="bottom">Bottom</option>
<option value="main">Main</option>
<option value="floating">Floating</option>
</select>
</div>
<div class="workspaces" data-testid="workspaces-panel">
<ul class="workspace-list">
<li class="workspace-row" data-testid="workspace-row" data-workspace-id="w-fe" data-shared=false>
<div class="workspace-title">
<strong>fe:feat/checkout</strong>
<span class="workspace-kind"> worktree</span>
</div>
<code class="workspace-path">/work/w-fe</code>
<a data-testid="workspace-pr" href="https://example.test/fe/pull/412" target="_blank" rel="noopener noreferrer">PR #412</a>
<div class="workspace-git">
<span class="muted">git status unknown</span>
<button type="button" data-testid="refresh-workspace">Refresh</button>
</div>
<ul class="workspace-threads" aria-label="Threads">
<li>
<button type="button" class="link">checkout-v2</button>
</li>
</ul>
<button type="button" data-testid="remove-workspace">Remove…</button>
</li>
<li class="workspace-row" data-testid="workspace-row" data-workspace-id="w-be" data-shared=true>
<div class="workspace-title">
<strong>be:main</strong>
<span class="workspace-kind"> worktree</span>
<span class="warning" data-testid="shared-warning" title="Several threads work in this directory: their changes mix.">⚠ shared by 2 threads</span>
</div>
<code class="workspace-path">/work/w-be</code>
<div class="workspace-git">
<span class="muted">git status unknown</span>
<button type="button" data-testid="refresh-workspace">Refresh</button>
</div>
<ul class="workspace-threads" aria-label="Threads">
<li>
<button type="button" class="link">checkout-v2</button>
</li>
<li>
<button type="button" class="link">flaky-tests</button>
</li>
</ul>
<button type="button" data-testid="remove-workspace">Remove…</button>
</li>
<li class="workspace-row" data-testid="workspace-row" data-workspace-id="w-be2" data-shared=false>
<div class="workspace-title">
<strong>be:flaky</strong>
<span class="workspace-kind"> worktree</span>
</div>
<code class="workspace-path">/work/w-be2</code>
<div class="workspace-git">
<span class="muted">git status unknown</span>
<button type="button" data-testid="refresh-workspace">Refresh</button>
</div>
<ul class="workspace-threads" aria-label="Threads">
<li>
<button type="button" class="link">flaky-tests</button>
</li>
</ul>
<button type="button" data-testid="remove-workspace">Remove…</button>
</li>
<li class="workspace-row" data-testid="workspace-row" data-workspace-id="w-adopted" data-shared=false>
<div class="workspace-title">
<strong>w-adopted</strong>
<span class="workspace-kind"> adopted</span>
</div>
<code class="workspace-path">/work/w-adopted</code>
<div class="workspace-git">
<span class="muted">git status unknown</span>
<button type="button" data-testid="refresh-workspace">Refresh</button>
</div>
<ul class="workspace-threads" aria-label="Threads">
<li>
<button type="button" class="link">idle-notes</button>
</li>
</ul>
</li>
</ul>
<form class="inline-form" data-testid="create-worktree">
<select aria-label="Repository" value="">
<option value="">Repository…</option>
<option value="r-fe">fe</option>
<option value="r-be">be</option>
</select>
<input aria-label="Branch (optional)" placeholder="branch (optional)" value=""/>
<button type="submit">New worktree</button>
</form>
<form class="inline-form" data-testid="adopt-workspace">
<input aria-label="Directory to adopt" placeholder="/path/to/directory" value=""/>
<button type="submit">Adopt</button>
</form>
<form class="inline-form" data-testid="add-repository">
<input aria-label="Repository path" placeholder="/path/to/repository" value=""/>
<button type="submit">Add repository</button>
</form>
</div>
</section>
</aside>
</div>
<div class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-testid="live-region">1 thread awaits input</div>
</div>
