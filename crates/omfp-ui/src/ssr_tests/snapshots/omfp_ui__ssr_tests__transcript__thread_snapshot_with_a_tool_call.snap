---
source: crates/omfp-ui/src/ssr_tests/transcript.rs
expression: "normalize(&render(input, ui))"
---
<div class="app" data-testid="app" tabindex="-1">
<div class="shell" data-testid="shell">
<nav class="sidebar" aria-label="Threads" data-testid="sidebar">
<div class="sidebar-actions">
<button type="button" data-testid="new-thread" title="New thread (Alt+N)">+ thread</button>
<button type="button" data-testid="next-attention" title="Next thread needing attention (Alt+A)">Next waiting (1)</button>
</div>
<div class="sidebar-controls">
<label>Group <select data-testid="grouping" value="none">
<option value="none">none</option>
<option value="tag">tag</option>
<option value="workspace">workspace</option>
<option value="repository">repository</option>
<option value="pr">pr</option>
</select>
</label>
<label>Filter <select data-testid="filter-key" value="">
<option value="">all</option>
<option value="archived">Archived</option>
<option value="tag:release">tag: release</option>
<option value="workspace:w-be2">workspace: be:flaky</option>
<option value="workspace:w-be">workspace: be:main</option>
<option value="workspace:w-fe">workspace: fe:feat/checkout</option>
<option value="workspace:w-adopted">workspace: w-adopted</option>
<option value="repository:r-be">repository: be</option>
<option value="repository:r-fe">repository: fe</option>
<option value="pr:fe#412">pr: fe#412</option>
</select>
</label>
<input type="search" data-testid="filter-text" aria-label="Search threads" placeholder="Search threads" value=""/>
</div>
<section class="thread-group" data-testid="thread-group" data-group="">
<ul class="thread-list">
<li>
<button type="button" class="thread-row" data-testid="thread-row" data-thread-id="t-checkout" data-status="awaiting" aria-current="true">
<span class="badge status-awaiting" data-testid="thread-status" data-status="awaiting" title="awaiting input">
<span aria-hidden="true">!</span>
<span class="sr-only">awaiting input</span>
</span>
<span class="thread-title">checkout-v2</span>
<span class="chips">
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-fe" data-cwd=true title="Working directory">
<span class="chip-cwd" aria-label="cwd">⌂</span>fe:feat/checkout<span class="chip-pr">#412</span>
</span>
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-be" data-cwd=false title="Workspace">be:main</span>
</span>
</button>
</li>
<li>
<button type="button" class="thread-row" data-testid="thread-row" data-thread-id="t-flaky" data-status="running">
<span class="badge status-running" data-testid="thread-status" data-status="running" title="running">
<span aria-hidden="true">◐</span>
<span class="sr-only">running</span>
</span>
<span class="thread-title">flaky-tests</span>
<span class="chips">
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-be" data-cwd=true title="Working directory">
<span class="chip-cwd" aria-label="cwd">⌂</span>be:main</span>
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-be2" data-cwd=false title="Workspace">be:flaky</span>
</span>
</button>
</li>
<li>
<button type="button" class="thread-row" data-testid="thread-row" data-thread-id="t-scratch" data-status="failed">
<span class="badge status-failed" data-testid="thread-status" data-status="failed" title="failed">
<span aria-hidden="true">✕</span>
<span class="sr-only">failed</span>
</span>
<span class="thread-title">scratch</span>
</button>
</li>
<li>
<button type="button" class="thread-row" data-testid="thread-row" data-thread-id="t-idle" data-status="idle">
<span class="badge status-idle" data-testid="thread-status" data-status="idle" title="idle">
<span aria-hidden="true">●</span>
<span class="sr-only">idle</span>
</span>
<span class="thread-title">idle-notes</span>
<span class="chips">
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-adopted" data-cwd=true title="Working directory">
<span class="chip-cwd" aria-label="cwd">⌂</span>w-adopted</span>
</span>
</button>
</li>
</ul>
</section>
<div class="sidebar-footer">
<label>Theme <select data-testid="theme" value="system">
<option value="system" selected=true>System</option>
<option value="light">Light</option>
<option value="dark">Dark</option>
</select>
</label>
</div>
</nav>
<main class="main" data-testid="main">
<section class="thread" data-testid="thread" data-thread-id="t-checkout" aria-label="Thread">
<header class="thread-header" data-testid="thread-header">
<div class="header-title">
<h1 data-testid="thread-title">checkout-v2</h1>
<ul class="tags" aria-label="Tags">
<li class="tag" data-testid="thread-tag">release</li>
</ul>
<button type="button" data-testid="edit-header">Edit</button>
</div>
<div class="header-workspaces">
<span class="chip-with-action">
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-fe" data-cwd=true title="Working directory">
<span class="chip-cwd" aria-label="cwd">⌂</span>fe:feat/checkout<a class="chip-pr" href="https://example.test/fe/pull/412" target="_blank" rel="noopener noreferrer">#412</a>
</span>
<button type="button" class="icon" data-testid="detach-workspace" aria-label="Detach fe:feat/checkout">×</button>
</span>
<span class="chip-with-action">
<span class="chip" data-testid="workspace-chip" data-workspace-id="w-be" data-cwd=false title="Workspace">be:main</span>
<button type="button" class="icon" data-testid="detach-workspace" aria-label="Detach be:main">×</button>
</span>
<select data-testid="attach-workspace" aria-label="Attach a workspace" value="">
<option value="">Attach workspace…</option>
<option value="w-be2">be:flaky</option>
<option value="w-adopted">w-adopted</option>
</select>
</div>
<div class="header-session">
<select data-testid="model-select" aria-label="Model" value="fake/scripted">
<option value="fake/scripted" selected=true>Scripted (fake)</option>
</select>
<select data-testid="thinking-select" aria-label="Thinking level" value="low">
<option value="off">off</option>
<option value="low" selected=true>low</option>
</select>
<span class="meter" data-testid="context-usage" title="Context window usage">2% of 128k</span>
</div>
<div class="header-process">
<span class="badge status-awaiting" data-testid="thread-state" data-status="awaiting" title="awaiting input">
<span aria-hidden="true">!</span>
<span class="sr-only">awaiting input</span>
</span>
<span class="state-label">awaiting input</span>
<button type="button" data-testid="process-action">Stop</button>
</div>
<div class="header-lifecycle">
<button type="button" data-testid="archive-thread">Archive</button>
<button type="button" class="danger" data-testid="delete-thread">Delete…</button>
</div>
</header>
<div class="transcript" data-testid="transcript" data-thread-id="t-checkout" data-pinned=true role="log" aria-label="Transcript" tabindex="0">
<div class="transcript-content">
<div class="spacer" data-testid="spacer-top" style="height: 0px">
</div>
<div class="transcript-item" data-testid="transcript-item" data-key="m0">
<article class="message role-user" data-testid="message" data-role="user" data-streaming=false aria-busy=false>
<div class="message-label">You</div>
<div class="plain" data-testid="plain-text">run echo</div>
</article>
</div>
<div class="transcript-item" data-testid="transcript-item" data-key="m1">
<article class="message role-assistant" data-testid="message" data-role="assistant" data-streaming=false aria-busy=false>
<div class="message-label">Assistant</div>
<section class="tool-card status-succeeded" data-testid="tool-card" data-tool="bash" data-status="succeeded" aria-label="Tool bash">
<div class="collapsible" data-expanded=true>
<button type="button" class="disclosure" data-testid="toggle" aria-expanded=true aria-controls="body-t-checkout/m1/0">
<span class="disclosure-mark" aria-hidden="true">▾</span>
<span class="tool-name">bash</span>
<span class="tool-summary" data-testid="tool-summary">command: echo tool-output-123</span>
<span class="tool-status" data-testid="tool-status">done</span>
</button>
<div id="body-t-checkout/m1/0" class="disclosure-body">
<div class="tool-section">
<h4>Arguments</h4>
<pre class="json" data-testid="tool-args">{
  &#34;command&#34;: &#34;echo tool-output-123&#34;
}</pre>
</div>
<div class="tool-section">
<h4>Result</h4>
<pre class="tool-result" data-testid="tool-result">tool-output-123
</pre>
</div>
</div>
</div>
</section>
</article>
</div>
<div class="transcript-item" data-testid="transcript-item" data-key="m3">
<article class="message role-assistant" data-testid="message" data-role="assistant" data-streaming=false aria-busy=false>
<div class="message-label">Assistant</div>
<div class="markdown" data-testid="markdown">
<p>The command printed tool-output-123.</p>
</div>
</article>
</div>
<div class="spacer" data-testid="spacer-bottom" style="height: 0px">
</div>
</div>
</div>
<form class="composer" data-testid="composer" data-busy=false>
<textarea class="composer-input" data-testid="composer-input" aria-label="Message" aria-keyshortcuts="Enter Shift+Enter Alt+Enter Escape Tab" placeholder="Message (/ for commands)" rows="3" value="">
</textarea>
<div class="composer-actions">
<button type="submit" class="primary" data-testid="send" data-mode="prompt">Send</button>
</div>
</form>
</section>
</main>
<aside class="side" data-testid="side-panels" aria-label="Panels">
<section class="panel" data-testid="panel" data-panel="workspaces" data-kind="workspaces" data-placement="side" aria-label="Workspaces">
<div class="panel-header">
<h2>Workspaces</h2>
<select data-testid="panel-placement" aria-label="Move the Workspaces panel" value="side">
<option value="side" selected=true>Side</option>
<option value="bottom">Bottom</option>
<option value="main">Main</option>
<option value="floating">Floating</option>
</select>
</div>
<div class="workspaces" data-testid="workspaces-panel">
<ul class="workspace-list">
<li class="workspace-row" data-testid="workspace-row" data-workspace-id="w-fe" data-shared=false>
<div class="workspace-title">
<strong>fe:feat/checkout</strong>
<span class="workspace-kind"> worktree</span>
</div>
<code class="workspace-path">/work/w-fe</code>
<a data-testid="workspace-pr" href="https://example.test/fe/pull/412" target="_blank" rel="noopener noreferrer">PR #412</a>
<div class="workspace-git">
<span class="muted">git status unknown</span>
<button type="button" data-testid="refresh-workspace">Refresh</button>
</div>
<ul class="workspace-threads" aria-label="Threads">
<li>
<button type="button" class="link">checkout-v2</button>
</li>
</ul>
<button type="button" data-testid="remove-workspace">Remove…</button>
</li>
<li class="workspace-row" data-testid="workspace-row" data-workspace-id="w-be" data-shared=true>
<div class="workspace-title">
<strong>be:main</strong>
<span class="workspace-kind"> worktree</span>
<span class="warning" data-testid="shared-warning" title="Several threads work in this directory: their changes mix.">⚠ shared by 2 threads</span>
</div>
<code class="workspace-path">/work/w-be</code>
<div class="workspace-git">
<span class="muted">git status unknown</span>
<button type="button" data-testid="refresh-workspace">Refresh</button>
</div>
<ul class="workspace-threads" aria-label="Threads">
<li>
<button type="button" class="link">checkout-v2</button>
</li>
<li>
<button type="button" class="link">flaky-tests</button>
</li>
</ul>
<button type="button" data-testid="remove-workspace">Remove…</button>
</li>
<li class="workspace-row" data-testid="workspace-row" data-workspace-id="w-be2" data-shared=false>
<div class="workspace-title">
<strong>be:flaky</strong>
<span class="workspace-kind"> worktree</span>
</div>
<code class="workspace-path">/work/w-be2</code>
<div class="workspace-git">
<span class="muted">git status unknown</span>
<button type="button" data-testid="refresh-workspace">Refresh</button>
</div>
<ul class="workspace-threads" aria-label="Threads">
<li>
<button type="button" class="link">flaky-tests</button>
</li>
</ul>
<button type="button" data-testid="remove-workspace">Remove…</button>
</li>
<li class="workspace-row" data-testid="workspace-row" data-workspace-id="w-adopted" data-shared=false>
<div class="workspace-title">
<strong>w-adopted</strong>
<span class="workspace-kind"> adopted</span>
</div>
<code class="workspace-path">/work/w-adopted</code>
<div class="workspace-git">
<span class="muted">git status unknown</span>
<button type="button" data-testid="refresh-workspace">Refresh</button>
</div>
<ul class="workspace-threads" aria-label="Threads">
<li>
<button type="button" class="link">idle-notes</button>
</li>
</ul>
</li>
</ul>
<form class="inline-form" data-testid="create-worktree">
<select aria-label="Repository" value="">
<option value="">Repository…</option>
<option value="r-fe">fe</option>
<option value="r-be">be</option>
</select>
<input aria-label="Branch (optional)" placeholder="branch (optional)" value=""/>
<button type="submit">New worktree</button>
</form>
<form class="inline-form" data-testid="adopt-workspace">
<input aria-label="Directory to adopt" placeholder="/path/to/directory" value=""/>
<button type="submit">Adopt</button>
</form>
<section class="repositories" data-testid="repositories" aria-labelledby="repositories-heading">
<h3 id="repositories-heading">Repositories</h3>
<ul class="repository-list">
<li class="repository-row" data-testid="repository-row" data-repository-id="r-fe">
<div class="workspace-title">
<strong>fe</strong>
<span class="muted" data-testid="repository-worktrees"> 1 worktree</span>
</div>
<code class="workspace-path">/src/fe</code>
<span class="muted" data-testid="repository-base">base main</span>
<div class="choice-buttons">
<button type="button" data-testid="repository-new-worktree">New worktree</button>
<button type="button" data-testid="remove-repository">Remove…</button>
</div>
</li>
<li class="repository-row" data-testid="repository-row" data-repository-id="r-be">
<div class="workspace-title">
<strong>be</strong>
<span class="muted" data-testid="repository-worktrees"> 2 worktrees</span>
</div>
<code class="workspace-path">/src/be</code>
<span class="muted" data-testid="repository-base">base main</span>
<div class="choice-buttons">
<button type="button" data-testid="repository-new-worktree">New worktree</button>
<button type="button" data-testid="remove-repository">Remove…</button>
</div>
</li>
</ul>
<form class="inline-form" data-testid="add-repository">
<input aria-label="Repository path" placeholder="/path/to/repository" value=""/>
<button type="submit">Add repository</button>
</form>
</section>
</div>
</section>
</aside>
</div>
<div class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-testid="live-region">checkout-v2: awaiting input. 1 thread awaits input</div>
</div>
