// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`transcript snapshots a bash tool call 1`] = `"<div class="omfp-transcript" data-testid="transcript" data-thread-id="01T" data-pinned="true" role="log" aria-label="Transcript" tabindex="0" data-omfp-scope="transcript"><div class="omfp-transcript__content"><div class="omfp-transcript__list" style="height: 300px; position: relative;"><div data-index="0" data-key="m0" data-testid="transcript-item" tabindex="-1" class="omfp-transcript__item" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(0px);"><article class="omfp-message" data-testid="message" data-role="user" data-streaming="false" aria-busy="false"><div class="omfp-message__label">You</div><div class="omfp-message__plain omfp-prose" data-testid="plain-text">run echo</div></article></div><div data-index="1" data-key="m1" data-testid="transcript-item" tabindex="-1" class="omfp-transcript__item" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(100px);"><article class="omfp-message" data-testid="message" data-role="assistant" data-streaming="false" aria-busy="false"><div class="omfp-message__label">Assistant</div><section data-testid="tool-card" data-tool="bash" data-status="succeeded" aria-label="Tool bash" class="omfp-card omfp-tool-card" data-tone="default" data-expanded="false"><header class="omfp-card__header"><button data-testid="toggle" class="omfp-card__toggle" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" aria-expanded="false" aria-controls="id-2" id="id-1"><span class="omfp-card__chevron" aria-hidden="true"></span><span class="omfp-card__title"><span class="omfp-tool-card__name">bash</span><span class="omfp-tool-card__summary" data-testid="tool-summary">command: echo tool-output-123</span><span class="omfp-tool-card__status" data-testid="tool-status">done</span></span></button></header><div id="id-2" class="omfp-card__body" hidden=""></div></section></article></div><div data-index="2" data-key="m3" data-testid="transcript-item" tabindex="-1" class="omfp-transcript__item" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(200px);"><article class="omfp-message" data-testid="message" data-role="assistant" data-streaming="false" aria-busy="false"><div class="omfp-message__label">Assistant</div><div data-testid="markdown" class="omfp-prose omfp-markdown"><p>The command printed tool-output-123.</p></div></article></div></div></div></div>"`;

exports[`transcript snapshots a text reply 1`] = `"<div class="omfp-transcript" data-testid="transcript" data-thread-id="01T" data-pinned="true" role="log" aria-label="Transcript" tabindex="0" data-omfp-scope="transcript"><div class="omfp-transcript__content"><div class="omfp-transcript__list" style="height: 200px; position: relative;"><div data-index="0" data-key="m0" data-testid="transcript-item" tabindex="-1" class="omfp-transcript__item" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(0px);"><article class="omfp-message" data-testid="message" data-role="user" data-streaming="false" aria-busy="false"><div class="omfp-message__label">You</div><div class="omfp-message__plain omfp-prose" data-testid="plain-text">say hi</div></article></div><div data-index="1" data-key="m1" data-testid="transcript-item" tabindex="-1" class="omfp-transcript__item" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(100px);"><article class="omfp-message" data-testid="message" data-role="assistant" data-streaming="false" aria-busy="false"><div class="omfp-message__label">Assistant</div><div data-testid="markdown" class="omfp-prose omfp-markdown"><p>Hello from the fake model</p></div></article></div></div></div></div>"`;
