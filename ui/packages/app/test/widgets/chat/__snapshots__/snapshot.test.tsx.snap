exports[`transcript snapshots a bash tool call 1`] = `"<div class="omfp-transcript omfp-focus-inset" data-testid="transcript" data-thread-id="01T" data-pinned="true" role="log" aria-label="Transcript" tabindex="0" data-omfp-scope="transcript"><div class="omfp-transcript__content"><div class="omfp-transcript__list" style="height: 300px; position: relative;"><div data-index="0" data-key="m0" data-testid="transcript-item" tabindex="-1" class="omfp-transcript__item omfp-focus-item" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(0px);"><article data-testid="message" data-role="user" data-streaming="false" data-continues="false" aria-busy="false" class="omfp-msg omfp-message" data-author="user"><div class="omfp-msg__name">▸ You</div><div class="omfp-msg__body"><div class="omfp-message__plain omfp-prose" data-testid="plain-text">run echo</div></div></article></div><div data-index="1" data-key="m1" data-testid="transcript-item" tabindex="-1" class="omfp-transcript__item omfp-focus-item" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(100px);"><article data-testid="message" data-role="assistant" data-streaming="false" data-continues="false" aria-busy="false" class="omfp-msg omfp-message" data-author="assistant"><div class="omfp-msg__name omfp-grad-text">◆ Assistant</div><div class="omfp-msg__body"><div class="omfp-tool-card" data-testid="tool-card" data-tool="bash" data-call="call_bash_1" data-view="bash" data-status="succeeded"><section aria-label="Tool bash" class="omfp-tool" data-status="done"><h2 class="omfp-tool__heading"><button data-testid="toggle" class="omfp-tool__head" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" aria-expanded="false" aria-controls="id-2" id="id-1"><span class="omfp-tool__label"><span aria-hidden="true" class="omfp-state-mark" data-state="done" data-spinner="status"></span><span class="omfp-tool__name">bash</span><span class="omfp-tool__arg"><span class="omfp-tool-card__subject" data-testid="tool-subject">echo tool-output-123</span><span class="omfp-tool-card__summary" data-testid="tool-summary"></span></span><span class="omfp-tool__meta"><span class="omfp-visually-hidden" data-testid="tool-status">done</span><span data-testid="tool-exit" class="omfp-exit" data-ok="true">exit 0</span></span></span></button></h2><div id="id-2" class="omfp-tool__body" hidden=""></div></section></div></div></article></div><div data-index="2" data-key="m3" data-testid="transcript-item" tabindex="-1" class="omfp-transcript__item omfp-focus-item" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(200px);"><div data-testid="message" data-role="assistant" data-streaming="false" data-continues="true" aria-busy="false" class="omfp-msg omfp-message" data-author="assistant"><div class="omfp-msg__body"><div data-testid="markdown" class="omfp-prose omfp-markdown"><p>The command printed tool-output-123.</p></div></div></div></div></div></div></div>"`;

exports[`transcript snapshots a text reply 1`] = `"<div class="omfp-transcript omfp-focus-inset" data-testid="transcript" data-thread-id="01T" data-pinned="true" role="log" aria-label="Transcript" tabindex="0" data-omfp-scope="transcript"><div class="omfp-transcript__content"><div class="omfp-transcript__list" style="height: 200px; position: relative;"><div data-index="0" data-key="m0" data-testid="transcript-item" tabindex="-1" class="omfp-transcript__item omfp-focus-item" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(0px);"><article data-testid="message" data-role="user" data-streaming="false" data-continues="false" aria-busy="false" class="omfp-msg omfp-message" data-author="user"><div class="omfp-msg__name">▸ You</div><div class="omfp-msg__body"><div class="omfp-message__plain omfp-prose" data-testid="plain-text">say hi</div></div></article></div><div data-index="1" data-key="m1" data-testid="transcript-item" tabindex="-1" class="omfp-transcript__item omfp-focus-item" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(100px);"><article data-testid="message" data-role="assistant" data-streaming="false" data-continues="false" aria-busy="false" class="omfp-msg omfp-message" data-author="assistant"><div class="omfp-msg__name omfp-grad-text">◆ Assistant</div><div class="omfp-msg__body"><div data-testid="markdown" class="omfp-prose omfp-markdown"><p>Hello from the fake model</p></div></div></article></div></div></div></div>"`;
