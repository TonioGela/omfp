From 489b090e91a275002e078703c04d5ea1fce5127e Mon Sep 17 00:00:00 2001
From: omfp <omfp@localhost>
Date: Tue, 10 Nov 2026 19:07:49 +0100
Subject: [PATCH] feat: accept bun lockfile version 2

Bun 1.4 writes `lockfileVersion: 2` in bun.lock. Its package entries keep
the version 1 shape bun2nix already parses (the new top-level
`configVersion` field is ignored), so accept versions 1 and 2.
---
 programs/bun2nix/src/lib.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/programs/bun2nix/src/lib.rs b/programs/bun2nix/src/lib.rs
index c4df1ba..40e8d27 100644
--- a/programs/bun2nix/src/lib.rs
+++ b/programs/bun2nix/src/lib.rs
@@ -26,7 +26,7 @@ use wasm_bindgen::prelude::*;
 pub fn convert_lockfile_to_nix_expression(contents: String, options: Options) -> Result<String> {
     let lockfile = contents.parse::<Lockfile>()?;
 
-    if lockfile.lockfile_version != 1 {
+    if !(1..=2).contains(&lockfile.lockfile_version) {
         return Err(Error::UnsupportedLockfileVersion(lockfile.lockfile_version));
     };
 
